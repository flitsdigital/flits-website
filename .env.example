# Copy to .env for local builds; set the same names in the Vercel project. Never commit .env.

# Google PageSpeed Insights API key (free): https://developers.google.com/speed/docs/insights/v5/get-started
PSI_API_KEY=

# The deployed site that PageSpeed measures: the Vercel URL until the domain moves, then https://flitsdigital.nl
SITE_URL=
