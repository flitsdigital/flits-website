---
import { Image } from 'astro:assets';
import map from '../../assets/images/widgets/map.jpg';
import pin from '../../assets/images/widgets/pin-brand.svg';
import expand from '../../assets/images/widgets/expand-small.svg';
import { contact } from '../../data/site';

interface Props {
  address?: string;
  class?: string;
}

const { address = contact.shortAddress, class: className } = Astro.props;
const href = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(address)}`;
---

<a class:list={['map', className]} href={href} target="_blank" rel="noopener" aria-label={`${address} op Google Maps (opent in nieuw tabblad)`}>
  <Image src={map} alt="" width={560} />
  <span class="map__expand"><img src={expand.src} width={10} height={10} alt="" /></span>
  <img class="map__pin" src={pin.src} width={14} height={14} alt="" />
  <span class="map__address">{address}</span>
</a>

<style>
  .map {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    width: 17.25rem; /* 276px */
    height: 8.8125rem; /* 141px */
    padding: var(--space-8);
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--color-light-0);
  }
  .map > :global(img:first-child) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .map__expand {
    position: absolute;
    top: var(--space-8);
    right: var(--space-8);
    display: grid;
    padding: var(--space-4);
    border-radius: var(--radius-xs);
    background: var(--color-light-0);
  }
  .map__pin {
    position: absolute;
    left: 95px;
    top: 38px;
  }
  .map__address {
    position: relative;
    padding: var(--space-8);
    border-radius: var(--radius-sm);
    background: var(--color-light-0);
    color: var(--color-dark-900);
    font: var(--text-caption);
    text-align: center;
  }
</style>
