---
import LogoNav from '../../assets/brand/logo.svg';
import LogoFooter from '../../assets/brand/logo-footer.svg';

interface Props {
  variant?: 'nav' | 'footer';
  class?: string;
}

const { variant = 'nav', class: className } = Astro.props;
// Inline, so the bolt (the first path in both files) can flash
const Svg = variant === 'footer' ? LogoFooter : LogoNav;
---

<Svg class:list={['logo', className]} role="img" aria-label="Flits" />

<style>
  :global(.logo) {
    height: auto;
  }

  /* The bolt flickers like lightning: every 7s on its own, and on hover */
  @media (prefers-reduced-motion: no-preference) {
    :global(.logo path:first-child) {
      animation: logo-flash-idle 7s steps(1, end) 2s infinite;
    }
    :global(:is(.logo:hover, a:hover > .logo) path:first-child) {
      animation: logo-flash 0.6s steps(1, end);
    }
  }
  @keyframes logo-flash {
    15% { opacity: 0.15; }
    30% { opacity: 1; }
    45% { opacity: 0.35; }
    60% { opacity: 1; }
    75% { opacity: 0.6; }
  }
  /* The same flicker squeezed into the first 0.6s of the 7s cycle */
  @keyframes logo-flash-idle {
    1.3% { opacity: 0.15; }
    2.6% { opacity: 1; }
    3.9% { opacity: 0.35; }
    5.1% { opacity: 1; }
    6.4% { opacity: 0.6; }
    7.7% { opacity: 1; }
  }
</style>
