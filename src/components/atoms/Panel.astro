---
interface Props {
  theme?: 'surface' | 'dark';
  as?: 'section' | 'div' | 'article';
  /** default: 1344px with 48px page margin · wide: 1380px with 30px (case gallery) · full: no max, the content keeps its own */
  width?: 'default' | 'wide' | 'full';
  class?: string;
}

const { theme = 'surface', as: Tag = 'div', width = 'default', class: className } = Astro.props;
---

<Tag class:list={['panel', { 'panel--wide': width === 'wide', 'panel--full': width === 'full' }, className]} data-theme={theme} data-theme-section={theme === 'dark' ? 'dark' : undefined}><slot /></Tag>

<style>
  /* Figma: 1344px rounded block with 48px page margin */
  .panel {
    position: relative;
    width: var(--width-panel);
    margin-inline: auto;
    border-radius: var(--radius-lg);
    overflow: clip;
  }
  /* two panels in a row never touch: the same gap as the page margin */
  .panel + .panel {
    margin-top: var(--gutter-panel);
  }
  .panel--wide {
    width: max(var(--grid-width), min(100% - 60px, 86.25rem)); /* never inside the grid's edges */
  }
  .panel--full {
    width: calc(100% - 2 * var(--gutter-panel));
  }
</style>
