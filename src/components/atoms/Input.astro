---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'input'> & {
  /** A textarea with the same look (contact modal, step 02). */
  multiline?: boolean;
};

const { class: className, type = 'text', multiline = false, ...rest } = Astro.props;
---

{
  multiline ? (
    <textarea class:list={['input', 'input--multiline', className]} {...(rest as HTMLAttributes<'textarea'>)} />
  ) : (
    <input class:list={['input', className]} type={type} {...rest} />
  )
}

<style>
  .input {
    width: 100%;
    /* Chrome clamps input line-height to "normal"; pin Figma's 0.9 line box (46.4px) */
    height: calc(0.9em + 2 * var(--space-16));
    padding: var(--space-16);
    border: 0;
    border-radius: var(--radius-sm);
    /* Figma #f4f4f4 field on the white form card (was surface = white there, so invisible) */
    background: var(--color-light-100);
    color: var(--color-text-secondary);
    font: var(--text-ui);
  }
  .input--multiline {
    height: auto;
    min-height: 8.5rem;
    font: var(--text-body-desc);
    resize: vertical;
  }
  .input::placeholder {
    color: inherit;
    opacity: 0.65; /* Figma 40% is ~2.6:1; 65% reaches 4.5:1 on the grey field */
  }
</style>
