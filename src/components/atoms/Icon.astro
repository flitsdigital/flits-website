---
import type { ImageMetadata } from 'astro';
import type { SvgComponent } from 'astro/types';

const icons = import.meta.glob<SvgComponent & ImageMetadata>('../../assets/icons/*.svg', {
  eager: true,
  import: 'default',
});
const byName = Object.fromEntries(
  Object.entries(icons).map(([path, svg]) => [path.split('/').pop()!.replace('.svg', ''), svg]),
);

import type { IconName } from '../../design-system/icons';
export type { IconName };

interface Props {
  name: IconName;
  /** Box size in px (the Figma icon frame); the SVG keeps its own size, centered. */
  size?: number;
  label?: string;
  class?: string;
}

const { name, size = 24, label, class: className } = Astro.props;
// Figma draws 👈 as the 👉 asset mirrored (rotate 180° + flip Y), so it shares one file.
const flip = name === 'hand-left';
const file = flip ? 'hand-right' : name;
const Svg = byName[file];
if (!Svg) throw new Error(`Icon "${name}" not found in src/assets/icons`);
// The rest are one colour (currentColor), inlined so they follow `color`; these keep their own colours.
const multicolour = file === 'google' || file === 'hand-right';
---

<span
  class:list={['icon', { 'icon--flip': flip }, className]}
  style={`--icon-size:${size}px`}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
>
  {multicolour ? <img src={Svg.src} width={Svg.width} height={Svg.height} alt="" /> : <Svg />}
</span>

<style>
  .icon {
    display: inline-grid;
    place-items: center;
    flex-shrink: 0;
    width: var(--icon-size);
    height: var(--icon-size);
  }
  .icon--flip {
    scale: -1 1;
  }
</style>
