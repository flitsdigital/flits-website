---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt?: string;
  size?: number;
  /** Ring in the surface color, used when avatars overlap. */
  ring?: boolean;
  /** eager for above-the-fold avatars (hero). */
  loading?: 'lazy' | 'eager';
  class?: string;
}

const { src, alt = '', size = 32, ring = false, loading = 'lazy', class: className } = Astro.props;
---

<span class:list={['avatar', { 'avatar--ring': ring }, className]} style={`--avatar-size:${size}px`}>
  <Image src={src} alt={alt} width={size * 2} height={size * 2} loading={loading} />
</span>

<style>
  .avatar {
    display: inline-block;
    flex-shrink: 0;
    width: var(--avatar-size);
    height: var(--avatar-size);
    border-radius: var(--radius-pill);
    overflow: hidden;
  }
  /* Figma center stroke: 2px straddling the edge (1px in, 1px out), photo stays full size */
  .avatar--ring {
    outline: 2px solid var(--color-bg);
    outline-offset: -1px;
  }
  .avatar :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
