---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { relativeDay, isToday } from '../../lib/relative-day';

interface Props {
  /** Pins "today" (ISO) for the widgets page; otherwise the browser recomputes the label. */
  today?: string;
  class?: string;
}

const { today, class: className } = Astro.props;
// Newest uploaded office photo (src/content/office-photos.json). No LIVE/REC: it is a photo, not a camera.
const photo = (await getCollection('officePhotos')).sort((a, b) => +b.data.date - +a.data.date)[0];
const now = today ? new Date(`${today}T12:00:00`) : new Date();
---

<!-- Look: prototype 71 (feature/widget-ideas), without the fake camera HUD. Label: src/scripts/office-widget.ts -->
{photo && (
<figure class:list={['office', className]} data-office={today ? undefined : photo.data.date.toISOString()}>
  <Image class="office__photo" src={photo.data.image} alt="Het kantoor van Flits in Emmen" width={700} />
  <p class="office__title">Kijk binnen</p>
  <figcaption class="office__caption">
    <span>Ons kantoor in Emmen</span>
    <span class="office__when">
      <span class="office__fresh" data-office-fresh hidden={!isToday(photo.data.date, now)}>vers</span>
      <span data-office-when>foto van {relativeDay(photo.data.date, now)}</span>
    </span>
  </figcaption>
</figure>
)}

<style>
  .office {
    position: relative;
    width: 21rem; /* 336px */
    aspect-ratio: 2;
    margin: 0;
    border-radius: var(--radius-md);
    overflow: hidden;
    color: var(--color-light-0);
  }
  .office :global(.office__photo) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .office::after {
    content: '';
    position: absolute;
    inset: 45% 0 0;
    background: var(--gradient-shade-bottom);
  }
  .office__title {
    position: absolute;
    top: var(--space-12);
    left: var(--space-12);
    z-index: 1;
    padding: var(--space-4) var(--space-8);
    border-radius: var(--radius-pill);
    background: var(--color-dark-900-60);
    font: var(--text-widget-title);
  }
  .office__caption {
    position: absolute;
    inset: auto var(--space-12) var(--space-12);
    z-index: 1;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font: var(--text-widget-title);
  }
  .office__when {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    font: var(--text-widget-meta);
  }
  .office__fresh {
    padding: 2px var(--space-6);
    border-radius: var(--radius-pill);
    background: var(--color-brand-500);
    color: var(--color-dark-900);
    font-weight: 600;
  }
  .office__fresh[hidden] {
    display: none;
  }
</style>
