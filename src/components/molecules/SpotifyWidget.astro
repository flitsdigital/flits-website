---
import logo from '../../assets/images/widgets/spotify-logo.svg';
import play from '../../assets/images/widgets/play.svg';
import { getImage } from 'astro:assets';
import { getTracks } from '../../lib/spotify';
import { neighbours } from '../../lib/spotify-ids';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;

// Tracks from src/content/tracks.json; artwork comes from Spotify (oEmbed), which their guidelines allow
// as long as it links back to Spotify. The covers are downloaded at build and served from our own site, so
// visitors' browsers contact Spotify only after they press play. The script switches tracks.
const selfHosted = async (url: string) => {
  try {
    return (await getImage({ src: url, width: 160, inferSize: true })).src;
  } catch {
    return url; // shortcut: Spotify's CDN unreachable at build → hotlink this once rather than break the build
  }
};
const tracks = await Promise.all((await getTracks()).map(async (t) => ({ ...t, cover: await selfHosted(t.cover) })));
const now = tracks[0];
const { prev, next } = neighbours(0, Math.max(1, tracks.length));
const left = tracks[prev];
const right = tracks[next];
---

<!-- Figma 991:4187 (168×168). Positions are the design's, in rem. Playback: src/scripts/spotify.ts -->
{now && (
<div class:list={['spotify', className]} data-spotify={now.uri} data-spotify-tracks={JSON.stringify(tracks)}>
  <span class="spotify__embed" aria-hidden="true"><span data-spotify-embed></span></span>
  <img class="spotify__glow" src={now.cover} alt="" data-spotify-glow />
  <button class="spotify__cover spotify__cover--left" type="button" data-spotify-step="-1" aria-label={`Vorig nummer: ${left.title}`}>
    <img src={left.cover} width="64" height="64" alt="" />
  </button>
  <button class="spotify__cover spotify__cover--right" type="button" data-spotify-step="1" aria-label={`Volgend nummer: ${right.title}`}>
    <img src={right.cover} width="64" height="64" alt="" />
  </button>
  <span class="spotify__text" aria-live="polite">
    <span data-spotify-title>{now.title}</span>
    <span class="spotify__artist" data-spotify-artist>{now.artist}</span>
  </span>
  <img class="spotify__cover spotify__cover--now" src={now.cover} width="80" height="80" alt="" data-spotify-now />
  <a class="spotify__logo" data-spotify-link href={now.href} target="_blank" rel="noopener" aria-label={`${now.title} van ${now.artist} op Spotify (opent in nieuw tabblad)`}>
    <img src={logo.src} width={logo.width} height={logo.height} alt="" />
  </a>
  <span class="spotify__player">
    <button class="spotify__play" type="button" data-spotify-play aria-pressed="false" aria-label={`Speel ${now.title} van ${now.artist}`}>
      <img src={play.src} width={play.width} height={play.height} alt="" />
      <span class="spotify__pause"></span>
    </button>
    <span class="spotify__track"><span class="spotify__fill" data-spotify-fill></span></span>
  </span>
</div>

)}
<style>
  .spotify {
    position: relative;
    display: block;
    width: 10.5rem; /* 168px; positions below are % of it, so the card scales with a slot */
    aspect-ratio: 1;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--color-light-0);
    color: var(--color-light-0);
  }
  .spotify > * {
    position: absolute;
  }
  .spotify__glow {
    left: 50%;
    top: -17.44%; /* -29.3px of 168 */
    width: 122.41%; /* 205.65px */
    height: 122.41%;
    translate: -50% 0;
    object-fit: cover;
    filter: blur(25px);
  }
  .spotify::after {
    content: '';
    position: absolute;
    top: 45.83%; /* 77px */
    inset-inline: 0;
    height: 56.62%; /* 95.12px */
    background: linear-gradient(rgb(29 12 33 / 0), rgb(29 12 33 / 0.6));
  }
  .spotify__text {
    z-index: 1;
  }
  .spotify__cover {
    z-index: 1;
    border-radius: var(--radius-sm);
    object-fit: cover;
    transition: rotate 0.3s ease;
  }
  /* Side covers are buttons: previous / next track */
  button.spotify__cover {
    padding: 0;
    border: 0;
    overflow: hidden;
    background: none;
    cursor: pointer;
  }
  button.spotify__cover img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  button.spotify__cover:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }
  .spotify__cover--left {
    left: 10.23%; /* 17.18px */
    top: 13.78%; /* 23.15px */
    width: 37.61%; /* 63.18px */
    height: 37.61%;
    rotate: -7.05deg;
  }
  .spotify__cover--right {
    left: 55.91%; /* 93.93px */
    top: 13.24%; /* 22.24px */
    width: 35.09%; /* 58.95px */
    height: 35.09%;
    rotate: 7.65deg;
  }
  .spotify:hover .spotify__cover--left {
    rotate: -11deg;
  }
  .spotify:hover .spotify__cover--right {
    rotate: 11deg;
  }
  .spotify__cover--now {
    z-index: 2;
    left: 50%;
    top: 7.47%; /* 12.55px */
    width: 46.63%; /* 78.33px */
    height: 46.63%;
    translate: -50% 0;
    box-shadow: 0 5px 15px rgb(0 0 0 / 0.3);
  }
  .spotify__text {
    left: 20.24%; /* 34px */
    top: 61%; /* 102.48px */
    width: 60.12%; /* 101px */
    display: grid;
    gap: var(--space-4);
    font: var(--text-widget-title);
    font-size: 0.625rem; /* 10px semibold */
    letter-spacing: -0.1px;
    text-align: center;
  }
  .spotify__artist {
    opacity: 0.6;
  }
  .spotify__logo {
    z-index: 1;
    display: block;
    left: 5.95%; /* 10px */
    top: 79.76%; /* 134px */
    width: 13.69%; /* 23px */
  }
  .spotify__logo img {
    display: block;
    width: 100%;
    height: auto;
  }
  /* Spotify's embed does the playing; kept rendered (it won't play at 0×0) but out of sight */
  .spotify__embed {
    width: 300px;
    height: 80px;
    opacity: 0;
    pointer-events: none;
    left: 0;
    top: 0;
    z-index: -1;
  }
  .spotify__player {
    z-index: 1;
    left: 24.99%; /* 41.98px */
    top: 79.74%; /* 133.96px */
    width: 68.3%; /* 114.74px */
    height: 14.08%; /* 23.66px */
    display: flex;
    align-items: center;
    border-radius: var(--radius-pill);
    background: rgb(244 244 244 / 0.2);
  }
  .spotify__play {
    display: grid;
    place-items: center;
    flex: none;
    width: 1.103rem; /* 17.64px */
    height: 1.103rem;
    margin-left: 0.189rem; /* 3.03px */
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--color-light-0);
    cursor: pointer;
    transition: scale 0.15s ease;
  }
  .spotify__play:active {
    scale: 0.9;
  }
  .spotify__play:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }
  .spotify__play img {
    width: 0.5rem; /* 8px, the 24px icon scaled */
    height: 0.5rem;
  }
  /* Pause: two bars, shown while playing */
  .spotify__pause {
    display: none;
    width: 0.4375rem;
    height: 0.5rem;
    border-inline: 2px solid var(--color-dark-900);
  }
  .spotify[data-playing] .spotify__play img {
    display: none;
  }
  .spotify[data-playing] .spotify__pause {
    display: block;
  }
  .spotify[data-loading] .spotify__play {
    animation: spotify-loading 0.8s ease-in-out infinite alternate;
  }
  @keyframes spotify-loading {
    to {
      opacity: 0.5;
    }
  }
  .spotify__track {
    flex: 1;
    margin-right: 0.6rem;
    height: 1.627px;
    margin-left: 0.466rem; /* 70.06 - 45.01 - 17.64 */
    border-radius: var(--radius-pill);
    background: rgb(255 255 255 / 0.3);
  }
  .spotify__fill {
    display: block;
    width: 0; /* set from Spotify's playback position */
    height: 100%;
    border-radius: inherit;
    background: var(--color-light-0);
    transition: width 0.5s linear; /* Spotify reports the position about twice a second */
  }
  @media (prefers-reduced-motion: reduce) {
    .spotify__cover,
    .spotify__fill {
      transition: none;
    }
    .spotify[data-loading] .spotify__play {
      animation: none;
    }
  }
</style>
