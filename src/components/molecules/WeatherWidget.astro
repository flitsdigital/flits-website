---
import { Image, getImage } from 'astro:assets';
import dot from '../../assets/images/widgets/live-dot.svg';
import { contact } from '../../data/site';

interface Props {
  temperature?: string;
  condition?: string;
  date?: string;
  /** Pins one photo ("herfst-nacht-regen") and turns off the live weather, e.g. for the components page. */
  scene?: string;
  class?: string;
}

// Static design values until scripts/weather.ts fills in the live Open-Meteo weather (and keeps them if it fails).
const { temperature = '24 °', condition = 'Lekker zonnetje', date = '10 sep', scene, class: className } = Astro.props;

// One photo per season × daypart × sky ("herfst-ochtend-regen", see lib/weather.ts), made from one street photo of the office.
const files = import.meta.glob<{ default: ImageMetadata }>('../../assets/images/widgets/weather/*.jpg', { eager: true });
const photos = scene
  ? undefined
  : Object.fromEntries(
      await Promise.all(
        Object.entries(files).map(async ([path, m]) => [path.split('/').pop()!.replace('.jpg', ''), (await getImage({ src: m.default, width: 400 })).src]),
      ),
    );
const dir = '../../assets/images/widgets/weather/';
const photo = (files[`${dir}${scene}.jpg`] ?? files[`${dir}zomer-middag-helder.jpg`]).default;
---

<div class:list={['weather', className]} data-weather={photos && JSON.stringify(photos)}>
  <Image src={photo} alt="" width={400} />
  <div class="weather__top">
    <p class="weather__row"><span class="weather__title">Flits Digital</span><img src={dot.src} width={dot.width} height={dot.height} alt="" /></p>
    <p class="weather__row weather__meta"><span>{contact.city}, Nederland</span>{' '}<span data-weather-date>{date}</span></p>
  </div>
  <div class="weather__bottom">
    <p class="weather__temp" data-weather-temp>{temperature}</p>
    <p class="weather__meta" data-weather-condition>{condition}</p>
  </div>
</div>

<style>
  .weather {
    position: relative;
    width: var(--span-2);
    aspect-ratio: 1;
    border-radius: var(--radius-md);
    overflow: hidden;
    color: var(--color-light-0);
  }
  .weather > :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .weather::before,
  .weather::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    height: 50%;
  }
  .weather::before {
    top: 0;
    background: var(--gradient-shade-top);
  }
  .weather::after {
    bottom: 0;
    background: var(--gradient-shade-bottom);
  }
  .weather__top,
  .weather__bottom {
    position: absolute;
    inset-inline: 0;
    z-index: 1;
    display: grid;
    padding: var(--space-12);
  }
  .weather__top {
    top: 0;
    gap: var(--space-6);
  }
  .weather__bottom {
    bottom: 0;
    gap: var(--space-4);
  }
  .weather__row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }
  .weather__title {
    font: var(--text-widget-title);
  }
  .weather__meta {
    font: var(--text-widget-meta);
    opacity: 0.8;
  }
  .weather__temp {
    font: var(--text-widget-value);
  }
</style>
