---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Pill from '../atoms/Pill.astro';
import ArrowTile from '../atoms/ArrowTile.astro';
import { projectHref, hasCase } from '../../lib/content';

interface Props {
  project: CollectionEntry<'projects'>;
  /** The archive (/projecten) leaves the year pill out. */
  showYear?: boolean;
  /** h2 when the cards sit directly under the page h1 (archive); h3 under a section h2. */
  titleAs?: 'h2' | 'h3';
  class?: string;
}

const { project, showYear = true, titleAs: Title = 'h3', class: className } = Astro.props;
const { client, title, date, tags, badge, cover } = project.data;
const pills = showYear ? [String(date.getFullYear()), ...tags] : tags;
// Only projects with a case page link through (and show the ↗ tile); the rest are a card only.
const linked = hasCase(project);
const Root = linked ? 'a' : 'div';
---

<Root class:list={['project-card', className]} href={linked ? projectHref(project.id) : undefined}>
  <div class="project-card__media">
    <Image src={cover} alt="" width={1200} widths={[600, 1200]} sizes="(min-width: 1440px) 599px, 50vw" />
    <div class="project-card__overlay">
      <div class="project-card__top">
        <div class="project-card__tags">{pills.map((tag) => <Pill>{tag}</Pill>)}</div>
        {badge && <Pill variant="solid" class="project-card__badge">{badge}</Pill>}
      </div>
      {linked && <ArrowTile class="project-card__arrow" />}
    </div>
  </div>
  <div class="project-card__text">
    <p class="project-card__client">{client}</p>
    <Title class="project-card__title">{title}</Title>
  </div>
</Root>

<style>
  .project-card {
    display: grid;
    gap: var(--space-16);
  }
  .project-card__media {
    position: relative;
    aspect-ratio: 599 / 446;
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  .project-card__media > :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .project-card__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: var(--gradient-image-overlay);
  }
  .project-card__top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding: var(--space-24);
  }
  .project-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }
  .project-card :global(.project-card__badge) {
    margin-inline-start: auto;
  }
  .project-card :global(.project-card__arrow) {
    align-self: flex-end;
    margin: var(--space-16);
  }
  .project-card__text {
    display: grid;
    gap: 3px;
    padding-inline: var(--space-24);
  }
  .project-card__client {
    font: var(--text-body);
    color: var(--color-text-muted); /* no extra opacity: keeps ≥4.5:1 */
  }
  .project-card__title {
    font: var(--text-body-m);
    color: var(--color-text);
  }
</style>
