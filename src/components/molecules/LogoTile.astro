---
import type { ImageMetadata } from 'astro';

interface Props {
  /** Omit logo + name for the yellow call-to-action tile (its text goes in the slot). */
  logo?: ImageMetadata;
  name?: string;
  class?: string;
}

const { logo, name = '', class: className } = Astro.props;
---

<!-- Figma 1:1772: a logo centred in a 276×216 white rounded tile (logowall, logo fan) -->
<div class:list={['logo-tile', { 'logo-tile--cta': !logo }, className]}>
  {logo ? <img src={logo.src} width={logo.width} height={logo.height} alt={name} loading="lazy" /> : <slot />}
</div>

<style>
  .logo-tile {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    border-radius: var(--radius-sm);
    aspect-ratio: 276 / 216;
    background: var(--color-light-0);
    overflow: hidden;
  }
  .logo-tile img {
    max-width: 100%;
    height: auto;
  }
  .logo-tile--cta {
    padding: var(--space-24);
    background: var(--color-brand-500);
    color: var(--color-dark-900);
    font: var(--text-display-30);
    letter-spacing: var(--tracking-display);
    text-align: center;
    text-transform: uppercase;
  }
</style>
