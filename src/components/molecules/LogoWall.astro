---
import type { CollectionEntry } from 'astro:content';
import LogoTile from './LogoTile.astro';

interface Props {
  clients: CollectionEntry<'clients'>[];
  class?: string;
}

const { clients, class: className } = Astro.props;
---

<!-- Osmo "Logo Wall Cycle" (script: scripts/logo-wall.ts): one row of 4 places, every 2.4s one place
     swaps its client tile for one from the rest. Data attributes as Osmo; the tiles are LogoTile (strip). -->
<div data-logo-wall-shuffle="false" data-logo-wall-cycle-init="" class:list={['logo-wall', className]}>
  <div class="logo-wall__collection">
    <div data-logo-wall-list="" class="logo-wall__list">
      {
        clients.map((c) => (
          <div data-logo-wall-item="" class="logo-wall__item">
            <div data-logo-wall-target-parent="" class="logo-wall__logo">
              <div class="logo-wall__logo-before" />
              <div data-logo-wall-target="" class="logo-wall__logo-target">
                <LogoTile size="strip" {...c.data} />
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</div>

<style>
  .logo-wall {
    display: flex;
    justify-content: center;
    width: 100%;
  }

  .logo-wall__collection {
    width: 100%;
  }

  .logo-wall__list {
    display: flex;
    flex-flow: wrap;
  }

  /* One row of 4 at every width; 5px padding makes the 10px gap of the old strip */
  .logo-wall__item {
    width: 25%;
    padding: 5px;
    position: relative;
  }

  [data-logo-wall-list] [data-logo-wall-item]:nth-child(n + 5) {
    display: none;
  }

  /* The tile clips the swap, so logos slide within their own rounded box */
  .logo-wall__logo {
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
    border-radius: var(--radius-sm);
    overflow: clip;
  }

  /* 204 × 83: the strip tile's shape (Figma 1:1371) */
  .logo-wall__logo-before {
    padding-top: 40.69%;
  }

  .logo-wall__logo-target {
    justify-content: center;
    align-items: center;
    inset: 0;
    display: flex;
    position: absolute;
  }

  .logo-wall__logo-target :global(.logo-tile) {
    width: 100%;
    height: 100%;
  }
  .logo-wall__logo-target :global(.logo-tile img) {
    max-width: 80%;
    max-height: 70%;
    width: auto;
    height: auto;
  }
</style>
