---
import type { ImageMetadata } from 'astro';

interface Props {
  logos: { name: string; logo: ImageMetadata }[];
  class?: string;
}

const { logos, class: className } = Astro.props;
---

<!-- Osmo "Logo Wall Cycle" (script: scripts/logo-wall.ts): one row of 4 places, every 2.4s one place
     swaps its logo for one from the rest. Data attributes and markup as Osmo. -->
<div data-logo-wall-shuffle="false" data-logo-wall-cycle-init="" class:list={['logo-wall', className]}>
  <div class="logo-wall__collection">
    <div data-logo-wall-list="" class="logo-wall__list">
      {
        logos.map(({ name, logo }) => (
          <div data-logo-wall-item="" class="logo-wall__item">
            <div data-logo-wall-target-parent="" class="logo-wall__logo">
              <div class="logo-wall__logo-before" />
              <div data-logo-wall-target="" class="logo-wall__logo-target">
                <img
                  src={logo.src}
                  loading="lazy"
                  width={logo.width}
                  height={logo.height}
                  alt={name}
                  class="logo-wall__logo-img"
                  style={`--ratio:${(logo.width / logo.height).toFixed(3)}`}
                />
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</div>

<style>
  .logo-wall {
    display: flex;
    justify-content: center;
    width: 100%;
  }

  .logo-wall__collection {
    width: 100%;
  }

  .logo-wall__list {
    display: flex;
    flex-flow: wrap;
  }

  /* One row of 4; 2×2 on phones */
  .logo-wall__item {
    width: 25%;
    position: relative;
  }

  [data-logo-wall-list] [data-logo-wall-item]:nth-child(n + 5) {
    display: none;
  }

  .logo-wall__logo {
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
  }

  /* Lower cells than Osmo (66.66%) */
  .logo-wall__logo-before {
    padding-top: 56%;
  }

  .logo-wall__logo-target {
    justify-content: center;
    align-items: center;
    width: 90%;
    height: 66.66%;
    display: flex;
    position: absolute;
    container-type: size;
  }

  /* Same size = same area: width = a·√ratio (height a/√ratio), so wide and tall logos weigh the same;
     never wider or taller than the target box */
  .logo-wall__logo-img {
    width: min(100cqw, 35cqw * sqrt(var(--ratio)), 100cqh * var(--ratio));
    height: auto;
    aspect-ratio: var(--ratio);
  }

  @media (max-width: 767px) {
    .logo-wall__item {
      width: 50%;
    }
    .logo-wall__logo-before {
      padding-top: 45%;
    }
  }
</style>
