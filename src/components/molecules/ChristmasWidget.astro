---
import { Image, getImage } from 'astro:assets';
import { daysUntilChristmas, christmasStage, christmasLabel, christmasPhoto } from '../../lib/christmas';

interface Props {
  /** Pins a fixed state (no live countdown), e.g. for the widgets page. */
  days?: number;
  stage?: number;
  dark?: boolean;
  class?: string;
}

// Office photos: "dag-06" / "nacht-06", stage 0 (no decoration) to 12 (Christmas Eve). Missing ones fall back.
const files = import.meta.glob<{ default: ImageMetadata }>('../../assets/images/widgets/christmas/*.jpg', { eager: true });
const byKey = Object.fromEntries(Object.entries(files).map(([path, m]) => [path.split('/').pop()!.replace('.jpg', ''), m.default]));
const pinned = Astro.props.days !== undefined;

// Build-time values; scripts/christmas.ts sets the live ones on page load unless pinned.
const now = new Date();
const { days = daysUntilChristmas(now.getFullYear(), now.getMonth() + 1, now.getDate()), stage = christmasStage(now.getMonth() + 1, now.getDate()), dark = false, class: className } = Astro.props;
const photo = byKey[christmasPhoto(stage, dark, new Set(Object.keys(byKey)))!];
const photos = pinned
  ? undefined
  : Object.fromEntries(await Promise.all(Object.entries(byKey).map(async ([key, src]) => [key, (await getImage({ src, width: 480 })).src])));
---

<div class:list={['xmas', className]} data-christmas={photos && JSON.stringify(photos)}>
  <div class="xmas__count">
    <p class="xmas__text">Nog</p>
    <p class="xmas__digits" data-christmas-days aria-label={`${days} ${christmasLabel(days).toLowerCase()}`}>
      {String(days).padStart(2, '0').split('').map((d) => <span class="xmas__digit" aria-hidden="true">{d}</span>)}
    </p>
    <p class="xmas__text" data-christmas-label>{christmasLabel(days)}</p>
  </div>
  <Image class="xmas__photo" src={photo} alt="" width={480} />
</div>

<!-- Behaviour: src/scripts/christmas.ts (started per page by src/scripts/app.ts) -->

<style>
  .xmas {
    display: grid;
    grid-template-columns: 1fr 1.53fr; /* Figma frame 361: count 416, photo 638 */
    width: 21rem; /* 336px: 2:1 at the 168px height of the other widgets */
    aspect-ratio: 2;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--color-light-0);
    color: var(--color-dark-900);
  }
  .xmas__count {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: var(--space-6);
    text-align: center;
  }
  .xmas__text {
    font: var(--text-widget-title);
    font-size: 0.75rem;
  }
  .xmas__digits {
    display: flex;
    gap: 0.25rem;
  }
  /* Split-flap tile: dark card with a notch on both sides of the fold */
  .xmas__digit {
    position: relative;
    display: grid;
    place-items: center;
    width: 3.125rem; /* 50×68: Figma frame 361 scaled to 168px high */
    height: 4.25rem;
    border-radius: var(--radius-sm);
    background: var(--color-dark-900);
    color: var(--color-light-0);
    font: var(--text-display-24);
    font-size: 1.875rem;
  }
  .xmas__digit::before,
  .xmas__digit::after {
    content: '';
    position: absolute;
    top: 50%;
    width: 0.1875rem;
    height: 0.375rem;
    translate: 0 -50%;
    background: var(--color-light-0);
  }
  .xmas__digit::before {
    left: 0;
  }
  .xmas__digit::after {
    right: 0;
  }
  .xmas :global(.xmas__photo) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
