---
import Heading from '../atoms/Heading.astro';
import Button from '../atoms/Button.astro';
import Label from '../atoms/Label.astro';
import Input from '../atoms/Input.astro';

// Figma 1:2828 designs only the first ("Start") step of a multi-step form.
// shortcut: steps 01–03 and the stepping/submit logic are not designed yet — the indicator
// and VORIGE/VOLGENDE are in place (disabled) for fase 5.
const steps = ['Start', '01', '02', '03'];
---

<form class="contact-form" aria-labelledby="contact-form-title">
  <ol class="contact-form__steps" aria-label="Stappen">
    {steps.map((s, i) => <li aria-current={i === 0 ? 'step' : undefined}>{s}</li>)}
  </ol>
  <div class="contact-form__intro">
    <Heading as="h3" size="36" id="contact-form-title">Om te beginnen</Heading>
    <p>We zijn benieuwd naar wie je bent. En hebben wat contactinformatie nodig</p>
  </div>
  <div class="contact-form__fields">
    <div class="contact-form__row">
      <div class="contact-form__field">
        <Label for="cf-first" required>Voornaam</Label>
        <Input id="cf-first" name="firstName" autocomplete="given-name" placeholder="Vul hier je naam in" required />
      </div>
      <div class="contact-form__field">
        <Label for="cf-last">Achternaam</Label>
        <Input id="cf-last" name="lastName" autocomplete="family-name" placeholder="Vul hier je naam in" />
      </div>
    </div>
    <div class="contact-form__field">
      <Label for="cf-email" required>E-mailadres</Label>
      <Input id="cf-email" name="email" type="email" autocomplete="email" placeholder="naam@mail.nl" required />
    </div>
    <div class="contact-form__field">
      <Label for="cf-phone" required>Telefoonnummer</Label>
      <Input id="cf-phone" name="phone" type="tel" autocomplete="tel" placeholder="06 12345678" required />
    </div>
  </div>
  <div class="contact-form__nav">
    <Button variant="step" icon="hand-left" disabled>Vorige</Button>
    <Button variant="step" icon="hand-right" iconPosition="end" disabled>Volgende</Button>
  </div>
</form>

<style>
  .contact-form {
    display: grid;
    justify-items: center;
    border-radius: var(--radius-md);
    background: var(--color-light-0);
    color: var(--color-dark-800);
  }
  .contact-form__steps {
    display: flex;
    gap: 2px;
    margin-top: var(--space-16);
    padding: var(--space-4);
    border-radius: var(--radius-pill);
    background: var(--color-light-100);
    font: var(--text-body);
  }
  .contact-form__steps li {
    display: grid;
    place-items: center;
    min-width: 2.25rem;
    height: 2.25rem;
    padding: var(--space-10);
    border-radius: var(--radius-pill);
    opacity: 0.5;
  }
  .contact-form__steps li[aria-current] {
    background: var(--color-light-0);
    opacity: 0.8;
  }
  .contact-form__intro {
    display: grid;
    justify-items: center;
    gap: var(--space-8);
    width: min(100% - 2 * 49px, 31.375rem); /* 502px */
    margin-top: 2.125rem; /* title at y=94 */
    text-align: center;
    color: var(--color-dark-900);
  }
  .contact-form__intro p {
    max-width: 20.5rem; /* 328px */
    font: var(--text-body-desc);
    opacity: 0.8;
  }
  .contact-form__fields {
    display: grid;
    gap: var(--space-24);
    width: min(100% - 2 * 49px, 31.375rem);
    margin-top: 2.6875rem; /* fields at y=229 */
  }
  .contact-form__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-16);
  }
  .contact-form__field {
    display: grid;
    gap: 13px;
  }
  .contact-form__nav {
    display: flex;
    justify-content: space-between;
    width: 100%;
    margin-top: 3.8125rem; /* bar at y=557 */
    padding: var(--space-16);
    border-top: 1px solid var(--color-border-subtle);
  }
</style>
