---
interface Props {
  /** Bunny Stream HLS playlist (.m3u8). */
  src: string;
  /** Bunny thumbnail, shown until the video plays. */
  poster: string;
  /** Fill the parent (which sets the size) and crop, instead of a 16:9 box. */
  cover?: boolean;
  /** false: no autoplay; it plays (with sound) when someone presses play. */
  autoplay?: boolean;
}

const { src, poster, cover = false, autoplay = true } = Astro.props;
---

<!-- Osmo "Custom Bunny HLS Player (Basic)" (scripts/bunny-player.ts): autoplays muted and looped while in view,
     nothing loads before it scrolls in. The play/pause control is a <button> so it works by keyboard too. -->
<div
  class="bunny-player"
  data-bunny-player-init=""
  data-player-activated="false"
  data-player-autoplay={String(autoplay)}
  data-player-hover="idle"
  data-player-src={src}
  data-player-status="idle"
  data-player-update-size={cover ? 'cover' : 'false'}
>
  <div data-player-before="" class="bunny-player__before"></div>
  <video preload="auto" width="1920" height="1080" playsinline="" class="bunny-player__video"></video>
  <img src={poster} alt="" width="1920" height="1080" loading="lazy" class="bunny-player__placeholder" />
  <div class="bunny-player__dark"></div>
  <button type="button" data-player-control="playpause" class="bunny-player__playpause" aria-label="Video afspelen of pauzeren">
    <div class="bunny-player__big-btn">
      <svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 24 24" fill="none" class="bunny-player__pause-svg"
        ><path d="M16 5V19" stroke="currentColor" stroke-width="3" stroke-miterlimit="10"></path><path
          d="M8 5V19"
          stroke="currentColor"
          stroke-width="3"
          stroke-miterlimit="10"></path></svg
      >
      <svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 24 24" fill="none" class="bunny-player__play-svg"
        ><path
          d="M6 12V5.01109C6 4.05131 7.03685 3.4496 7.87017 3.92579L14 7.42855L20.1007 10.9147C20.9405 11.3945 20.9405 12.6054 20.1007 13.0853L14 16.5714L7.87017 20.0742C7.03685 20.5503 6 19.9486 6 18.9889V12Z"
          fill="currentColor"></path></svg
      >
    </div>
  </button>
  <div class="bunny-player__loading">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" width="100%" class="bunny-player__loading-svg" fill="none"
      ><path
        fill="currentColor"
        d="M73,50c0-12.7-10.3-23-23-23S27,37.3,27,50 M30.9,50c0-10.5,8.5-19.1,19.1-19.1S69.1,39.5,69.1,50"
        ><!-- On the path, not the <svg> (as Osmo had it): there "50 50" is the viewBox centre; on the svg it is 50 CSS px, off-centre at 6em -->
        <animateTransform
          attributeName="transform"
          attributeType="XML"
          type="rotate"
          dur="1s"
          from="0 50 50"
          to="360 50 50"
          repeatCount="indefinite"></animateTransform></path
      ></svg
    >
  </div>
</div>

<style>
  /* Osmo CSS from here; changes: our radius, 16:9 (the Bunny stream), and a reset for the <button> */
  .bunny-player {
    pointer-events: none;
    color: var(--color-light-0);
    isolation: isolate;
    border-radius: var(--radius-md);
    justify-content: center;
    align-items: center;
    width: 100%;
    display: flex;
    position: relative;
    overflow: hidden;
    transform: translateX(0);
  }

  .bunny-player__before {
    padding-top: 56.25%;
  }

  /* Cover Mode */
  [data-bunny-player-init][data-player-update-size='cover'] {
    height: 100%;
    top: 0;
    left: 0;
    position: absolute;
  }

  [data-bunny-player-init][data-player-update-size='cover'] [data-player-before] {
    display: none;
  }

  [data-bunny-player-init][data-player-update-size='cover'] .bunny-player__video {
    object-fit: cover;
  }

  /* Animation */
  [data-bunny-player-init] :is(.bunny-player__placeholder, .bunny-player__dark, .bunny-player__playpause, .bunny-player__loading) {
    transition:
      opacity var(--duration-m) linear,
      visibility var(--duration-m) linear;
  }

  /* Placeholder */
  .bunny-player__placeholder {
    object-fit: cover;
    width: 100%;
    height: 100%;
    position: absolute;
  }

  [data-bunny-player-init][data-player-status='playing'] .bunny-player__placeholder,
  [data-bunny-player-init][data-player-status='paused'] .bunny-player__placeholder,
  [data-bunny-player-init][data-player-activated='true'][data-player-status='ready'] .bunny-player__placeholder {
    opacity: 0;
    visibility: hidden;
  }

  /* Dark Overlay */
  .bunny-player__dark {
    opacity: 0.1;
    background-color: var(--color-black);
    width: 100%;
    height: 100%;
    position: absolute;
  }

  [data-bunny-player-init][data-player-status='paused'] .bunny-player__dark,
  [data-bunny-player-init][data-player-status='playing'][data-player-hover='active'] .bunny-player__dark {
    opacity: 0.3;
  }

  [data-bunny-player-init][data-player-status='playing'] .bunny-player__dark {
    opacity: 0;
  }

  .bunny-player__video {
    width: 100%;
    height: 100%;
    padding-bottom: 0;
    padding-right: 0;
    display: block;
    position: absolute;
    top: 0;
    left: 0;
  }

  /* Play/Pause */
  .bunny-player__playpause {
    pointer-events: auto;
    justify-content: center;
    align-items: center;
    width: 100%;
    height: 100%;
    display: flex;
    position: absolute;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
  }

  [data-bunny-player-init][data-player-status='playing'] .bunny-player__playpause,
  [data-bunny-player-init][data-player-status='loading'] .bunny-player__playpause {
    opacity: 0;
  }

  [data-bunny-player-init][data-player-status='playing'][data-player-hover='active'] .bunny-player__playpause,
  [data-bunny-player-init][data-player-status='playing'] .bunny-player__playpause:focus-visible {
    opacity: 1;
  }

  [data-bunny-player-init][data-player-status='playing'] .bunny-player__play-svg,
  [data-bunny-player-init][data-player-status='loading'] .bunny-player__play-svg {
    display: none;
  }

  [data-bunny-player-init][data-player-status='playing'] .bunny-player__pause-svg,
  [data-bunny-player-init][data-player-status='loading'] .bunny-player__pause-svg {
    display: block;
  }

  .bunny-player__big-btn {
    -webkit-backdrop-filter: blur(1em);
    backdrop-filter: blur(1em);
    cursor: pointer;
    background-color: var(--color-overlay-grey-20);
    border: 1px solid var(--color-overlay-light-10);
    border-radius: 50%;
    justify-content: center;
    align-items: center;
    width: 6em;
    height: 6em;
    padding: 2em;
    display: flex;
    position: relative;
  }

  .bunny-player__loading-svg {
    width: 6em;
  }

  .bunny-player__pause-svg {
    display: none;
  }

  @media screen and (max-width: 767px) {
    .bunny-player__big-btn {
      width: 20vw;
      height: 20vw;
      padding: 6vw;
    }
  }

  /* Loading */
  .bunny-player__loading {
    opacity: 0;
    visibility: hidden;
    background-color: var(--color-overlay-dark-40);
    justify-content: center;
    align-items: center;
    width: 100%;
    height: 100%;
    display: flex;
    position: absolute;
  }

  [data-bunny-player-init][data-player-status='loading'] .bunny-player__loading {
    opacity: 1;
    visibility: visible;
  }

  /* Docked (the video plays in the corner card): the poster holds its place here */
  [data-bunny-player-init][data-player-docked] .bunny-player__placeholder {
    opacity: 1;
    visibility: visible;
  }
</style>

<!-- The dock is built by scripts/bunny-player.ts on <body>, outside this component, so its CSS is global -->
<style is:global>
  .bunny-dock {
    position: fixed;
    z-index: 60; /* above the progressive blur (40), below the navbar (100) */
    right: var(--space-16);
    bottom: var(--space-16);
    width: min(15rem * var(--ar, 0.8), 20rem, 100vw - 2 * var(--space-16));
    aspect-ratio: var(--ar, 0.8);
    border-radius: var(--radius-md);
    overflow: hidden;
    isolation: isolate;
    background: var(--color-dark-900);
    box-shadow: 0 12px 32px rgb(0 0 0 / 0.25);
    color: var(--color-light-0);
    opacity: 0;
    translate: 0 0.75rem;
    scale: 0.96;
    transform-origin: bottom right;
    pointer-events: none;
    transition:
      opacity 0.15s var(--ease-out),
      translate 0.15s var(--ease-out),
      scale 0.15s var(--ease-out);
  }
  .bunny-dock[data-shown] {
    opacity: 1;
    translate: 0 0;
    scale: 1;
    pointer-events: auto;
    transition-duration: 0.25s;
  }
  @media (max-width: 767px) {
    .bunny-dock {
      width: min(11rem * var(--ar, 0.8), 15rem, 100vw - 2 * var(--space-16));
    }
  }
  .bunny-dock video {
    object-fit: cover;
  }
  .bunny-dock button {
    display: grid;
    place-items: center;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
  }
  .bunny-dock button:focus-visible {
    outline: 2px solid var(--color-brand-500);
    outline-offset: -2px;
  }
  /* The whole card: back to where the video lives */
  .bunny-dock .bunny-dock__back {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(rgb(0 0 0 / 0) 55%, rgb(0 0 0 / 0.45));
  }
  .bunny-dock .bunny-dock__btn {
    position: absolute;
    -webkit-backdrop-filter: blur(1em);
    backdrop-filter: blur(1em);
    background-color: #64646433; /* the player's own play button */
    border: 1px solid #ffffff1a;
    border-radius: 50%;
    transition: scale 0.15s var(--ease-out);
  }
  .bunny-dock__btn:active {
    scale: 0.92;
  }
  .bunny-dock__toggle {
    left: var(--space-8);
    bottom: var(--space-8);
    width: 2.25rem;
    height: 2.25rem;
  }
  .bunny-dock__toggle svg {
    grid-area: 1 / 1;
    width: 0.875rem;
  }
  .bunny-dock__pause,
  .bunny-dock[data-playing] .bunny-dock__play {
    display: none;
  }
  .bunny-dock[data-playing] .bunny-dock__pause {
    display: block;
  }
  .bunny-dock__close {
    top: var(--space-8);
    right: var(--space-8);
    width: 1.75rem;
    height: 1.75rem;
  }
  .bunny-dock__close svg {
    width: 0.625rem;
  }
  /* Thumb-sized hit area (44px) around the small buttons; the card itself is the "back" target */
  .bunny-dock__btn::before {
    content: '';
    position: absolute;
    inset: -0.5rem;
  }
  @media (prefers-reduced-motion: reduce) {
    .bunny-dock {
      translate: none;
      scale: none;
      transition: opacity 0.15s linear;
    }
  }
</style>
