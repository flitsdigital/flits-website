---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Heading from '../atoms/Heading.astro';

interface Props {
  href: string;
  image: ImageMetadata;
  label: string;
  class?: string;
}

const { href, image, label, class: className } = Astro.props;
---

<a class:list={['service-card', className]} href={href}>
  <Image src={image} alt="" width={1200} widths={[600, 1200]} sizes="600px" />
  <span class="service-card__label"><Heading as="span" size="24">{label}</Heading></span>
</a>

<style>
  .service-card {
    position: relative;
    display: block;
    aspect-ratio: 600 / 531;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--color-light-0);
    transition: opacity 0.2s ease;
  }
  /* shortcut: Figma shows both cards at 60% opacity (likely the idle state); full opacity on hover is inferred.
     Only where hover exists: on touch screens they would stay half see-through. */
  @media (hover: hover) and (pointer: fine) {
    .service-card {
      opacity: 0.6;
    }
    .service-card:hover,
    .service-card:focus-visible {
      opacity: 1;
    }
  }
  .service-card :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .service-card__label {
    position: absolute;
    left: 10px;
    right: var(--space-8);
    bottom: 12px;
    display: grid;
    place-items: center;
    padding: var(--space-24);
    border-radius: var(--radius-sm);
    background: var(--color-light-0);
    color: var(--color-dark-900);
  }

  @media (max-width: 767px) {
    .service-card__label {
      padding: var(--space-16);
    }
  }
</style>
