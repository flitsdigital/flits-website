---
// entry-animations branch only: pick and replay a home entry variant (full reload, so it plays as a first visit).
const variants = [
  'Huidig',
  'Soft focus',
  'Masked words',
  'Letter wave',
  'Lens',
  'Bolt strike',
  'Clip lines',
  'Converge',
  'Cinematic settle',
  'Deal',
  'Highlight first',
  'Lens × Converge',
  'Skills: animate',
];
---

<nav class="entry-switcher" aria-label="Entree-animatie kiezen" data-no-swup>
  <span class="entry-switcher__name" data-entry-name>Entree</span>
  <ol>
    {
      variants.map((name, i) => (
        <li>
          <a href={`/?entry=${i}`} title={name} data-entry-link={i}>{i}</a>
        </li>
      ))
    }
  </ol>
</nav>

<script is:inline define:vars={{ variants }}>
  const current = document.documentElement.dataset.entry || '0';
  document.querySelector(`[data-entry-link="${current}"]`)?.setAttribute('aria-current', 'true');
  const label = document.querySelector('[data-entry-name]');
  if (label) label.textContent = `${current} · ${variants[Number(current)] ?? ''}`;
</script>

<style>
  .entry-switcher {
    position: fixed;
    z-index: 300;
    bottom: var(--space-16);
    left: 50%;
    translate: -50% 0;
    display: flex;
    align-items: center;
    gap: var(--space-12);
    padding: var(--space-6) var(--space-6) var(--space-6) var(--space-16);
    border-radius: var(--radius-pill);
    background: var(--color-dark-900);
    color: var(--color-light-0);
    font: var(--text-ui-medium);
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.25);
  }
  .entry-switcher__name {
    min-width: 9.5rem;
    white-space: nowrap;
  }
  ol {
    display: flex;
    gap: 2px;
  }
  a {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: var(--radius-pill);
    opacity: 0.7;
  }
  a:hover {
    opacity: 1;
    background: rgb(255 255 255 / 0.1);
  }
  a[aria-current] {
    opacity: 1;
    background: var(--color-brand-500);
    color: var(--color-dark-900);
  }
</style>
