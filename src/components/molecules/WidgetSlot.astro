---
import { pools, fixed } from '../../data/widgets';
import { candidates, inSeason, initialWidget, pagePath, slotWidget, type WidgetId, type SlotSize } from '../../lib/slots';
import { widgetMeta, widgetComponent, isAvailable } from '../../widgets/registry';

interface Props {
  /** Slot name, unique per page; `fixed` in src/data/widgets.ts refers to it. */
  id: string;
  size: SlotSize;
  /** Shown in the HTML and when nothing else is available. */
  fallback: WidgetId;
  /** Pins the date (ISO) and turns off the random pick; only for /widgets. */
  today?: string;
  class?: string;
}

const { id, size, fallback, today, class: className } = Astro.props;

// Widgets come from src/widgets/ (registry.ts); one that has nothing real to show is left out.
const availability = Object.fromEntries(await Promise.all([fallback, ...pools[size]].map(async (w) => [w, await isAvailable(w)] as const)));
const available = (w: WidgetId) => availability[w] ?? false;
const pinned = fixed[pagePath(Astro.url.pathname)]?.[id];
// The fallback first, then the rest of the pool; only widgets that have something to show.
const pool = pinned ? [] : candidates([fallback, ...pools[size].filter((w) => w !== fallback)], available);
const seasons = Object.fromEntries(pool.map((w) => [w, widgetMeta[w].season]).filter(([, s]) => s));

// The HTML shows the first widget without a season (no layout shift when the browser picks another of the
// same size); seasonal ones (Christmas) are only templates, so a November page never flashes them.
// With a pinned date (/widgets) the slot is decided here.
let shown: WidgetId | null = pinned ?? initialWidget(pool, seasons);
if (today && !pinned) {
  const [, m, d] = today.split('-').map(Number);
  const fits = (w: WidgetId) => inSeason(widgetMeta[w].season, m, d);
  shown = slotWidget({ candidates: candidates(pool, fits), fallback, fallbackAvailable: false, random: () => 0 });
}
const Shown = shown && widgetComponent(shown);
const templates = pinned || today ? [] : pool.filter((w) => w !== shown);
const live = templates.length > 0;
---

{(Shown || live) && (
<div
  class:list={['slot', `slot--${size}`, className]}
  data-widget-slot={live ? id : undefined}
  data-slot-current={shown ?? ''}
  data-slot-seasons={live ? JSON.stringify(seasons) : undefined}
  hidden={!Shown}
>
  {Shown && <Shown />}
  {live && templates.map((w) => {
    const C = widgetComponent(w)!;
    return <template data-slot-option={w}><C /></template>;
  })}
</div>
)}

<!-- Behaviour: src/scripts/widget-slots.ts (first in pageInits, so swapped-in widgets start normally) -->

<style>
  /* Square slots sit on the grid like the weather card always did (2 columns = 168px at 1440) */
  .slot {
    display: grid;
    width: var(--span-2);
  }
  .slot--wide {
    width: 21rem; /* 336px */
  }
  .slot.slot > :global(*) {
    width: 100%; /* beats each widget's own fixed width */
  }
  .slot[hidden] {
    display: none;
  }
  /* The weather card also stretches in height on phones (next to the clock) */
  .slot > :global(.weather) {
    height: 100%;
  }
</style>
