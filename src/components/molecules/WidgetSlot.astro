---
import { getCollection } from 'astro:content';
import WeatherWidget from './WeatherWidget.astro';
import SpotifyWidget from './SpotifyWidget.astro';
import ChristmasWidget from './ChristmasWidget.astro';
import PageSpeedWidget from './PageSpeedWidget.astro';
import ReviewsWidget from './ReviewsWidget.astro';
import OfficeWidget from './OfficeWidget.astro';
import StoriesWidget from './StoriesWidget.astro';
import { widgets, pools, fixed } from '../../data/widgets';
import { candidates, inSeason, slotWidget, type WidgetId, type SlotSize } from '../../lib/slots';

interface Props {
  /** Slot name, unique per page; `fixed` in src/data/widgets.ts refers to it. */
  id: string;
  size: SlotSize;
  /** Shown in the HTML and when nothing else is available. */
  fallback: WidgetId;
  /** Pins the date (ISO) and turns off the random pick; only for /widgets. */
  today?: string;
  class?: string;
}

const { id, size, fallback, today, class: className } = Astro.props;

// Every widget a slot can show. Add new ones here and in src/data/widgets.ts.
const components: Partial<Record<WidgetId, typeof WeatherWidget>> = {
  weather: WeatherWidget,
  spotify: SpotifyWidget,
  christmas: ChristmasWidget,
  pagespeed: PageSpeedWidget,
  reviews: ReviewsWidget,
  office: OfficeWidget,
  stories: StoriesWidget,
};

// A widget fed by a collection only counts once that collection has an entry (no empty cards).
const counts: Partial<Record<WidgetId, number>> = {
  reviews: (await getCollection('reviews')).length,
  office: (await getCollection('officePhotos')).length,
  stories: (await getCollection('stories')).length,
};
const available = (w: WidgetId) => w in components && counts[w] !== 0;
const pinned = fixed[Astro.url.pathname]?.[id];
const options = pinned ? [] : candidates(pools[size], available).filter((w) => w !== fallback);

// With a pinned date (/widgets) the slot is decided here; otherwise the browser picks (scripts/widget-slots.ts).
// A seasonal fallback (Christmas) is not rendered visibly: the slot starts hidden and the browser decides, so a
// November page never flashes Christmas, and a slot with nothing in season is removed.
const seasonal = !pinned && !today && !!widgets[fallback].season;
let shown: WidgetId | null = seasonal ? null : (pinned ?? fallback);
if (today && !pinned) {
  const [, m, d] = today.split('-').map(Number);
  const fits = (w: WidgetId) => inSeason(widgets[w].season, m, d);
  shown = slotWidget({ candidates: candidates([fallback, ...options], fits), fallback, fallbackAvailable: fits(fallback), random: () => 0 });
}
const Shown = shown && components[shown];
const live = !pinned && !today && (seasonal || options.length > 0);
const templates = seasonal ? [fallback, ...options] : options;
const seasons = Object.fromEntries([fallback, ...options].map((w) => [w, widgets[w].season]).filter(([, s]) => s));
---

{(Shown || live) && (
<div
  class:list={['slot', `slot--${size}`, className]}
  data-widget-slot={live ? id : undefined}
  data-slot-current={shown ?? ''}
  data-slot-fallback={fallback}
  data-slot-seasons={live ? JSON.stringify(seasons) : undefined}
  hidden={!Shown}
>
  {Shown && <Shown />}
  {live && templates.map((w) => {
    const C = components[w]!;
    return <template data-slot-option={w}><C /></template>;
  })}
</div>
)}

<!-- Behaviour: src/scripts/widget-slots.ts (first in pageInits, so swapped-in widgets start normally) -->

<style>
  .slot {
    display: grid;
    justify-items: center;
    width: 10.5rem; /* 168px */
  }
  .slot--wide {
    width: 21rem; /* 336px */
  }
  .slot[hidden] {
    display: none;
  }
  /* The weather card stretches with its slot on tablet/phone; fixed-layout widgets keep their size */
  .slot > :global(.weather) {
    justify-self: stretch;
    width: 100%;
    height: 100%;
  }
</style>
