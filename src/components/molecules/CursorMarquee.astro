---
// Osmo "Cursor with Marquee Effect": hover anything with [data-cursor-marquee-text="…"] and that text
// scrolls in a pill that follows the pointer. One instance, in BaseLayout, outside the Swup container.
// Changes to the Osmo resource: brand styling (the yellow name pill with a bolt), the pill sits above
// the cursor, no idle dot when nothing is hovered, GSAP from npm, off on touch screens (no hover), and
// the pill is two names wide (a short name like "Joery" was always cut off at one name wide).
---

<div data-cursor-marquee-status="" class="cursor-marquee" aria-hidden="true">
  <div class="cursor-marquee__card">
    <span data-cursor-marquee-text-target="" class="cursor-marquee__text-span">Hello world</span>
    <span data-cursor-marquee-text-target="" class="cursor-marquee__text-span">Hello world</span>
    <span data-cursor-marquee-text-target="" class="cursor-marquee__text-span is--duplicate">Hello world</span>
  </div>
</div>


<!-- Behaviour: src/scripts/cursor-marquee.ts (started once by src/scripts/app.ts) -->

<style>
  .cursor-marquee {
    z-index: 300; /* above the fixed navbar (100) */
    pointer-events: none;
    justify-content: center;
    align-items: center;
    display: flex;
    position: fixed;
    top: 0;
    left: 0;
    transform: translate(-50%, -50%);
  }

  .cursor-marquee__card {
    color: var(--color-dark-900);
    background-color: var(--color-brand-500);
    justify-content: center;
    align-items: center;
    display: flex;
    position: absolute;
    overflow: hidden;
    transition:
      clip-path 0.4s cubic-bezier(0.75, 0, 0.25, 1),
      transform 0.4s cubic-bezier(0.75, 0, 0.25, 1),
      opacity 0.15s linear 0.3s;
    transform: translateY(0%) rotate(0.001deg);
    clip-path: inset(calc(50% - 0.25em) round 50em);
    will-change: clip-path;
    opacity: 0;
  }

  /* Above the cursor (Osmo: -25%, over it) */
  [data-cursor-marquee-status='active'] .cursor-marquee__card {
    clip-path: inset(0 round 50em);
    transform: translateY(calc(-50% - 1rem)) rotate(0.001deg);
    opacity: 1;
    transition-delay: 0s;
  }

  /* CSS Keyframe Animation */
  @keyframes translateXCursor {
    to {
      transform: translateX(-100%);
    }
  }

  /* Flits name pill (Ticker "pill"): 14px label, bolt after every name */
  .cursor-marquee__text-span {
    display: flex;
    align-items: center;
    gap: var(--space-8);
    white-space: nowrap;
    transform-origin: 0;
    padding: var(--space-6) var(--space-8) var(--space-6) 0;
    font: var(--text-body-s);
    line-height: 1;
    position: relative;
  }
  .cursor-marquee__text-span::before {
    content: '';
    width: var(--space-8);
    height: var(--space-8);
    margin-left: var(--space-8);
    background: currentColor;
    mask: url('../../assets/icons/bolt.svg') center / contain no-repeat;
    order: 1;
  }

  .cursor-marquee__text-span {
    animation: translateXCursor 10s linear infinite paused;
    transition: opacity 0.15s ease-in-out 0.25s;
    opacity: 0;
  }

  [data-cursor-marquee-status='active'] .cursor-marquee__text-span {
    transition: opacity 0.15s ease-in-out 0s;
    opacity: 1;
  }

  .cursor-marquee__text-span.is--duplicate {
    position: absolute;
    left: 100%;
  }
</style>
