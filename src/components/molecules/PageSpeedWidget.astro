---
import { band, env, measureAtBuild, type PageSpeed } from '../../lib/pagespeed';

interface Props {
  /** Pins a result (no live update), e.g. for the widgets page. */
  result?: PageSpeed;
  class?: string;
}

const { result: pinned, class: className } = Astro.props;
// Build-time measurement; the script asks /api/pagespeed for a fresher one and keeps this when that is stale.
const result = pinned ?? (await measureAtBuild());
const host = new URL(env('SITE_URL') ?? 'https://flitsdigital.nl').host.replace(/^www\./, '');
const score = result.mobile;
const date = new Intl.DateTimeFormat('nl-NL', { day: 'numeric', month: 'short', timeZone: 'Europe/Amsterdam' }).format(new Date(result.measuredAt)).replace('.', '');
---

<!-- Look: prototype 11 (feature/widget-ideas). Behaviour: src/scripts/pagespeed.ts -->
<div
  class:list={['speed', className]}
  data-pagespeed={pinned ? undefined : ''}
  data-mobile={result.mobile ?? ''}
  data-desktop={result.desktop ?? ''}
>
  <div>
    <p class="speed__title">PageSpeed</p>
    <p class="speed__meta">{host}</p>
  </div>
  <div class="speed__gauge" data-band={score === null ? 'none' : band(score)} data-speed-gauge role="img" aria-label={score === null ? 'PageSpeed-score: meting volgt' : `PageSpeed-score ${score} van 100`}>
    <svg viewBox="0 0 36 36" aria-hidden="true">
      <circle class="speed__track" cx="18" cy="18" r="16"></circle>
      <circle class="speed__arc" cx="18" cy="18" r="16" pathLength="100" style={`stroke-dashoffset: ${100 - (score ?? 0)}`} data-speed-arc></circle>
    </svg>
    <span class="speed__num" aria-hidden="true" data-speed-num>{score ?? '—'}</span>
  </div>
  <p class="speed__meta speed__when" data-speed-when>{score === null ? 'meting volgt' : `gemeten op ${date}`}</p>
  <div class="speed__seg" role="group" aria-label="Apparaat">
    <button type="button" aria-pressed="true" data-speed-device="mobile">📱 Mobiel</button>
    <button type="button" aria-pressed="false" data-speed-device="desktop">🖥️ Desktop</button>
  </div>
</div>

<style>
  .speed {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 10.5rem; /* 168px */
    aspect-ratio: 1;
    padding: var(--space-12);
    border-radius: var(--radius-md);
    background: var(--color-light-0);
    color: var(--color-dark-900);
  }
  .speed__title {
    font: var(--text-widget-title);
  }
  .speed__meta {
    margin-top: var(--space-4);
    font: var(--text-widget-meta);
    color: var(--color-text-muted);
  }
  .speed__when {
    margin-top: 0;
    text-align: center;
  }
  /* Colour follows Lighthouse's bands, so it passes red → orange → green while counting */
  .speed__gauge {
    --g: #0cce6b;
    --gt: #0a7a40;
    position: relative;
    display: grid;
    place-items: center;
    align-self: center;
    width: 4.25rem;
    aspect-ratio: 1;
  }
  .speed__gauge[data-band='mid'] {
    --g: #ffa400;
    --gt: #a85d00;
  }
  .speed__gauge[data-band='bad'] {
    --g: #ff4e42;
    --gt: #c5221f;
  }
  .speed__gauge[data-band='none'] {
    --g: var(--color-dark-900-60);
    --gt: var(--color-dark-900-60);
  }
  .speed__gauge svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    rotate: -90deg;
  }
  .speed__track {
    fill: color-mix(in srgb, var(--g) 10%, transparent);
    stroke: color-mix(in srgb, var(--g) 16%, transparent);
    stroke-width: 3;
  }
  .speed__arc {
    fill: none;
    stroke: var(--g);
    stroke-width: 3;
    stroke-dasharray: 100;
    stroke-linecap: round;
  }
  .speed__num {
    position: relative;
    font: var(--text-widget-title);
    font-size: 1.5rem;
    font-variant-numeric: tabular-nums;
    color: var(--gt);
  }
  .speed__seg {
    display: flex;
    padding: 2px;
    border-radius: var(--radius-pill);
    background: var(--color-light-100);
  }
  .speed__seg button {
    flex: 1;
    padding: var(--space-4) 0;
    border: 0;
    border-radius: var(--radius-pill);
    background: none;
    font: var(--text-widget-meta);
    line-height: 1.3;
    color: var(--color-text-muted);
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease;
  }
  .speed__seg button[aria-pressed='true'] {
    background: var(--color-light-0);
    color: var(--color-dark-900);
    box-shadow: 0 1px 3px rgb(20 2 24 / 0.12);
  }
  .speed__seg button:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 1px;
  }
</style>
