---
import { serviceTicker } from '../../data/site';
import type { CollectionEntry } from 'astro:content';
import Panel from '../atoms/Panel.astro';
import Button from '../atoms/Button.astro';
import SectionHeader from '../molecules/SectionHeader.astro';
import ProjectGrid from '../molecules/ProjectGrid.astro';

interface Props {
  title: string;
  /** Defaults to the service ticker. */
  ticker?: string[];
  projects: CollectionEntry<'projects'>[];
}

const { title, ticker = serviceTicker, projects } = Astro.props;
---

<Panel as="section" width="full" class="projects">
  <SectionHeader title={title} ticker={ticker}>
    <Fragment slot="actions">
      <Button variant="secondary" href="/projecten">Bekijk al onze projecten</Button>
      <Button href="/contact">Start een project</Button>
    </Fragment>
  </SectionHeader>
  <div class="projects__body"><ProjectGrid projects={projects} /></div>
</Panel>

<style>
  .projects__body {
    width: var(--grid-width); /* the panel runs full width, the cards stay on the grid */
    margin-inline: auto; /* no longer tucked 12px into the header's padding: that made the boxes overlap */
    padding-bottom: calc(var(--space-64) + var(--space-8)); /* 72px under the lowest card; the grid adds the 48px drop */
  }

  @media (max-width: 767px) {
    .projects__body {
      padding-bottom: var(--space-32);
    }
  }
</style>
