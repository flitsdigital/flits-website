---
import type { ImageMetadata } from 'astro';
import BgShapes from '../atoms/BgShapes.astro';
import PhotoBackdrop from '../atoms/PhotoBackdrop.astro';
import Heading from '../atoms/Heading.astro';
import HeroMedia from '../atoms/HeroMedia.astro';
import Bolt from '../../assets/icons/bolt.svg';

interface Props {
  image: ImageMetadata;
  title: string;
}

const { image, title } = Astro.props;
const mediaOverlap = 80; // px the media overlaps the hero (Figma)
---

<!-- Figma 1:1738 + 1:1770: team photo under a 50% dark-800 veil, bolts, title at the bottom -->
<section class="hero-photo" data-theme="dark" data-theme-section="dark">
  <PhotoBackdrop image={image} veil="brand" bleed />
  <BgShapes />
  <div class="hero-photo__title">
    <Bolt class="hero-photo__bolt" width={44} height={59} aria-hidden="true" />
    <Heading as="h1" size="116">{title}</Heading>
  </div>
</section>
{Astro.slots.has('media') && <HeroMedia overlap={mediaOverlap}><slot name="media" /></HeroMedia>}

<style>
  .hero-photo {
    position: relative;
    isolation: isolate; /* own stacking context, so hero media can overlap it */
    height: 59rem; /* 944px */
    overflow: hidden;
  }
  .hero-photo__title {
    position: absolute;
    top: 29.5rem; /* bolt at 472px */
    left: 50%;
    translate: -50% 0;
    display: grid;
    justify-items: center;
    gap: 30px;
    width: var(--span-6); /* still wraps after "ZIJN" */
    text-align: center;
    color: var(--color-light-100);
  }
  .hero-photo__bolt {
    color: var(--color-brand-500);
  }
  .hero-photo__title > :global(.heading) {
    justify-self: stretch; /* title box = the 6 columns, text centred */
  }
</style>
