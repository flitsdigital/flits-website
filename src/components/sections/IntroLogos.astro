---
import type { ImageMetadata } from 'astro';
import type { CollectionEntry } from 'astro:content';
import Avatar from '../atoms/Avatar.astro';
import Heading from '../atoms/Heading.astro';
import Text from '../atoms/Text.astro';
import Ticker from '../molecules/Ticker.astro';
import LogoWall from '../molecules/LogoWall.astro';

interface Props {
  ticker: string[];
  lead: string;
  joery: CollectionEntry<'team'>;
  jordi: CollectionEntry<'team'>;
  /** Client logos for the wall (dark, for a light background) */
  logos: { name: string; logo: ImageMetadata }[];
}

const { ticker, lead, joery, jordi, logos } = Astro.props;
---

<section class="intro">
  <div class="intro__text">
    <Ticker items={ticker} variant="light" />
    <!-- Home-only title with the faces inline in the sentence. Hovering a face spins it slowly and shows
         its name in the cursor marquee (CursorMarquee, BaseLayout). -->
    <Heading size="64" class="intro__title">
      Wij zijn <span class="intro__face" data-cursor-marquee-text="Joery"><Avatar src={joery.data.avatar} size={48} /></span> Joery<br />
      En <span class="intro__face" data-cursor-marquee-text="Jordi"><Avatar src={jordi.data.avatar} size={48} /></span> Jordi
    </Heading>
    <Text size="l" tone="secondary">{lead}</Text>
  </div>
  <LogoWall logos={logos} class="intro__logos" />
</section>

<style>
  .intro {
    padding-bottom: 6.4375rem; /* 103px to the next section */
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-48);
    text-align: center;
  }
  .intro__text {
    display: flex;
    flex-direction: column;
    gap: var(--space-24);
    width: min(var(--width-content), 37.5625rem); /* 601px */
  }
  .intro__text > :global(.ticker) {
    margin-bottom: calc(var(--space-16) - var(--space-24));
  }
  /* Faces sit in the line like a word: about the cap height, centred on the capitals */
  .intro__face {
    display: inline-block;
    width: 0.8em;
    height: 0.8em;
    margin-inline: 0.04em;
    vertical-align: -0.06em;
    animation: intro-face-spin 16s linear infinite paused;
  }
  .intro__face :global(.avatar) {
    display: block;
    width: 100%;
    height: 100%;
  }
  @media (hover: hover) and (pointer: fine) {
    .intro__face:hover {
      animation-play-state: running;
    }
  }
  @keyframes intro-face-spin {
    to {
      rotate: 1turn;
    }
  }
  .intro :global(.intro__logos) {
    width: min(var(--width-content), 46rem); /* the strip was 1031px; the logos sit closer together */
  }
  @media (max-width: 767px) {
    .intro {
      padding-bottom: var(--space-64);
      gap: var(--space-32);
    }
  }
  /* narrow Androids (360px): keep "Wij zijn [face] Joery" on one line */
  @media (max-width: 374px) {
    .intro :global(.intro__title) {
      font-size: 2rem;
    }
  }
</style>
