---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  /** Landscape mockups, each the full grid width, stacked. */
  images: ImageMetadata[];
}

const { images } = Astro.props;
---

<section class="case-wide">
  {images.map((src) => <Image src={src} alt="" widths={[800, 1400, 2400]} sizes="(min-width: 1440px) 1344px, 92vw" />)}
</section>

<style>
  .case-wide {
    display: grid;
    gap: var(--grid-gap);
    width: var(--grid-width);
    margin-inline: auto;
    margin-bottom: 9.5625rem; /* same rhythm as the gallery's gap to the next block */
  }
  .case-wide :global(img) {
    width: 100%;
    height: auto;
    border-radius: var(--radius-sm);
  }
</style>
