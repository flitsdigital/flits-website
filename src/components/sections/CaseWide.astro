---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  /** Landscape mockups, edge to edge with the panels' page margin, stacked. */
  images: ImageMetadata[];
}

const { images } = Astro.props;
---

<section class="case-wide">
  {images.map((src) => <Image src={src} alt="" widths={[800, 1400, 2400]} sizes="100vw" />)}
</section>

<style>
  .case-wide {
    display: grid;
    gap: var(--grid-gap);
    width: calc(100% - 2 * var(--gutter-panel)); /* same edges as Panel width="full" */
    margin-inline: auto;
    margin-bottom: 9.5625rem; /* same rhythm as the gallery's gap to the next block */
  }
  .case-wide :global(img) {
    width: 100%;
    height: auto;
    border-radius: var(--radius-sm);
  }
</style>
