---
import RadialSlider from '../molecules/RadialSlider.astro';
import BunnyPlayer from '../molecules/BunnyPlayer.astro';

interface Props {
  /** Bunny videos, the first one in the centre. */
  videos: { src: string; poster: string }[];
}

const { videos } = Astro.props;
---

<!-- Figma 1:2564–1:2573 / 1:3172: 400×500 cards on a ∪ arc tilted 18°, sides dimmed 40%,
     play button on the centre card (plays with sound, pauses once it leaves the centre), hands either side. -->
<div class="video-fan">
  <RadialSlider label="Video's" shape="valley" angle={18} hands={{ item: 'video', belowOnPhone: true }} class="video-fan__slider">
    {
      videos.map((video) => (
        <div class="video-fan__card">
          <BunnyPlayer {...video} cover autoplay={false} />
        </div>
      ))
    }
  </RadialSlider>
</div>

<style>
  /* On service pages it sits in the hero's "media" slot (24px overlap); on cases it stands alone */
  .video-fan {
    padding-bottom: var(--section-space-xl);
    overflow-x: clip;
  }
  .video-fan :global(.video-fan__slider) {
    height: 31.25rem; /* 500px: one card */
  }
  /* No position here: the slider makes each card absolute (also the containing block for the veil) */
  .video-fan__card {
    width: 25rem; /* 400px */
    height: 31.25rem;
    border-radius: var(--radius-ml);
    overflow: hidden;
  }
  /* Sides: 40% black veil and no play button; centre: clear */
  .video-fan__card::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--color-overlay-dark-40);
    pointer-events: none;
    transition: opacity var(--duration-m) var(--ease-out);
  }
  .video-fan__card[data-radial-slider-active]::after {
    opacity: 0;
  }
  .video-fan__card:not([data-radial-slider-active]) :global(.bunny-player__playpause) {
    visibility: hidden;
  }
</style>
