---
import SectionHeader from '../molecules/SectionHeader.astro';
import ContactForm from '../molecules/ContactForm.astro';
import ClockWidget from '../molecules/ClockWidget.astro';
import WidgetSlot from '../molecules/WidgetSlot.astro';

interface Props {
  title: string;
  lead: string;
}

const { title, lead } = Astro.props;
---

<!-- Figma 1:2828 + 1:2801 + 1:2804 + 1:2867: form left; title, lead and the widgets right -->
<!-- The text column comes first in the HTML so its h2 precedes the form's h3; the grid puts it right -->
<section class="contact" id="contact">
  <div class="contact__side">
    <SectionHeader title={title} lead={lead} softLead span={6} align="start" spaced={false} />
    <div class="contact__widgets">
      <ClockWidget layout="wide" />
      <WidgetSlot id="contact" size="square" fallback="weather" />
    </div>
    <WidgetSlot id="contact-wide" size="wide" fallback="christmas" class="contact__wide" />
  </div>
  <ContactForm />
</section>

<style>
  .contact {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr)); /* form 6 columns · text 6 columns */
    gap: var(--grid-gap);
    width: var(--grid-width);
    margin-inline: auto;
    padding-block: 2.8125rem 6.875rem; /* 109px under the FAQ (64px of it is the FAQ's margin) / 110px */
  }
  .contact__side {
    grid-column: 2;
    grid-row: 1;
    display: flex;
    flex-direction: column;
  }
  /* Clock (4 columns) bottom-aligned with the form, weather (2 columns) 40px under the lead on the right */
  .contact__widgets {
    flex: 1;
    display: grid;
    grid-template-columns: var(--span-4) var(--span-2);
    align-items: end;
    gap: var(--grid-gap);
    margin-top: 2.5rem; /* 40px */
  }
  .contact__side :global(.contact__wide) {
    margin-top: var(--grid-gap);
  }
  .contact__widgets > :global(.slot) {
    align-self: flex-start;
  }
  /* Tablet: the side column is 3 columns → clock 2 + weather 1 */
  @media (max-width: 991px) {
    .contact__widgets {
      grid-template-columns: var(--span-2) var(--span-1);
    }
    .contact__widgets > :global(*) {
      width: 100%;
    }
  }
  /* Phone: the form is what matters, so it comes straight after the title and lead; clock and
     weather follow (the clock across, the weather on 2 columns) */
  @media (max-width: 767px) {
    .contact {
      grid-template-columns: minmax(0, 1fr);
      row-gap: var(--space-32);
    }
    .contact__side {
      display: contents;
    }
    .contact__side > :global(.section-header) {
      order: 1;
    }
    .contact > :global(.contact-form) {
      order: 2;
    }
    .contact__side :global(.contact__wide) {
      order: 4; /* after the form and the clock/weather row, like the other widgets */
    }
    .contact__widgets {
      order: 3;
      margin-top: 0;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .contact__widgets > :global(.clock) {
      grid-column: 1 / -1;
    }
  }
</style>
