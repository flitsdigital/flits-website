---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import RadialSlider from '../molecules/RadialSlider.astro';

interface Props {
  /** Photos riding the arc; the first one begins in the centre. */
  images: ImageMetadata[];
}

const { images } = Astro.props;
// The loop copies are in the HTML, not cloned by the slider script: a copy made by the JS was a new, tilted
// (so bigger) photo and became a late LCP. shortcut: 3 sets fill screens up to ~2300px; wider ones still clone in JS.
const sets = [0, 1, 2];
---

<!-- Figma: three photos 352×253, tilted 10° per neighbour. Made into a slowly
     drifting radial slider (pauses on hover/focus, off-screen and with reduced motion). -->
<div class="fan">
  <RadialSlider label="Foto's van ons werk" speed={40} scroll={6} angle={10} class="fan__slider">
    {
      sets.map((set) =>
        images.map((src, i) => (
          <Image
            class="fan__photo"
            src={src}
            alt=""
            widths={[480, 704]}
            sizes="(max-width: 767px) 15.3rem, 22rem"
            loading="eager"
            fetchpriority={set === 0 && i === 0 ? 'high' : undefined}
            aria-hidden={set > 0 ? 'true' : undefined}
            inert={set > 0}
          />
        )),
      )
    }
  </RadialSlider>
</div>

<style>
  /* Place it in a hero's "media" slot; the hero sets the overlap. */
  .fan {
    height: 22.125rem; /* 354px: distance to the next section */
    overflow-x: clip; /* outer photos bleed past the viewport without horizontal scroll */
  }
  /* Slider box = the centre photo's height, so its centre lands where Figma has it (y=126.5) */
  .fan :global(.fan__slider) {
    height: 15.8125rem; /* 253px */
  }
  .fan :global(.fan__photo) {
    width: 22rem; /* 352px */
    height: 15.8125rem; /* 253px */
    object-fit: cover;
    border-radius: var(--radius-sm);
  }
  /* Before the slider script runs, the side photos sit stacked under the centre one instead of hidden,
     so they paint with the HTML: hidden until the JS, they became a late LCP (render delay 4.7s on PageSpeed) */
  .fan :global(.radial-slider:not([data-radial-slider-ready]) .radial-slider__track > .fan__photo:not(:first-child)) {
    visibility: visible;
  }
  .fan :global(.radial-slider:not([data-radial-slider-ready]) .radial-slider__track > .fan__photo:first-child) {
    z-index: 1;
  }

  @media (max-width: 767px) {
    .fan {
      height: 13rem; /* 32px under the centre photo */
    }
    .fan :global(.fan__slider) {
      height: 11rem;
      --radial-slider-gap: 32px; /* tighter than the site-wide 96px on phones */
    }
    .fan :global(.fan__photo) {
      width: 15.3rem;
      height: 11rem;
    }
  }
</style>
