---
import SectionHeader from '../molecules/SectionHeader.astro';
import type { ImageMetadata } from 'astro';
import Panel from '../atoms/Panel.astro';
import HandButton from '../atoms/HandButton.astro';
import StepCard from '../molecules/StepCard.astro';

interface Props {
  title: string;
  lead: string;
  steps: { image: ImageMetadata; title: string; text: string }[];
}

const { title, lead, steps } = Astro.props;
---

<!-- Figma 1:2492 / 1:2990: white panel, centred header, a row of 384px step cards that scrolls
     sideways; the 👉 on the panel edge moves one step. -->
<section class="steps" data-steps>
  <Panel>
    <div class="steps__inner">
      <SectionHeader title={title} lead={lead} width={817} spaced={false} />
      <ol class="steps__track" data-steps-track>
        {steps.map((s, i) => <li><StepCard step={i + 1} {...s} /></li>)}
      </ol>
    </div>
  </Panel>
  <HandButton direction="prev" label="Vorige stap" class="steps__nav steps__nav--prev" data-steps-prev hidden />
  <HandButton direction="next" label="Volgende stap" class="steps__nav steps__nav--next" data-steps-next />
</section>

<!-- Behaviour: src/scripts/process-steps.ts (started per page by src/scripts/app.ts) -->

<style>
  .steps {
    position: relative;
    margin-bottom: var(--space-48); /* panels below sit 48px lower (Figma 49px) */
  }
  .steps__inner {
    padding-block: 6.5625rem 5.6875rem; /* 105px / 91px */
  }
  .steps__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 24rem; /* 384px */
    gap: var(--space-48);
    margin-top: 5.3125rem; /* 85px */
    padding-inline: var(--gutter-panel);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter-panel);
    scrollbar-width: none;
  }
  .steps__track > li {
    scroll-snap-align: start;
  }
  /* Figma: the hand hangs 45px over the panel's edge, 86px below the top of the photos.
     The 👈 mirrors it on the left (not in Figma; feedback 2026-10-24). */
  .steps :global(.steps__nav) {
    position: absolute;
    top: 27.6875rem; /* 443px */
  }
  .steps :global(.steps__nav--next) {
    right: calc((100% - var(--width-panel)) / 2 - 45px);
  }
  .steps :global(.steps__nav--prev) {
    left: calc((100% - var(--width-panel)) / 2 - 45px);
  }
</style>
