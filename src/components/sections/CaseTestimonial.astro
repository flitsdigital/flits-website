---
import SectionHeader from '../molecules/SectionHeader.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { CollectionEntry } from 'astro:content';
import ReviewCard from '../molecules/ReviewCard.astro';

interface Props {
  title: string;
  lead: string;
  image: ImageMetadata;
  review: CollectionEntry<'reviews'>;
}

const { title, lead, image, review } = Astro.props;
---

<!-- Figma 1:3243 + 1:3258/1:3259: header in the 817 column, photo and the client's review side by side -->
<section class="case-testimonial">
  <SectionHeader title={title} lead={lead} span={8} align="start" spaced={false} />
  <div class="case-testimonial__row">
    <Image class="case-testimonial__img" src={image} alt="" widths={[600, 1200]} sizes="(min-width: 1440px) 600px, 45vw" />
    <ReviewCard {...review.data} class="case-testimonial__review" />
  </div>
</section>

<style>
  .case-testimonial {
    display: grid;
    gap: 7.3125rem; /* 117px */
    padding-block: 8.1875rem 8.3125rem; /* 131px / 133px */
  }
  .case-testimonial__row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr)); /* 6 columns each */
    gap: var(--grid-gap);
    width: var(--grid-width);
    margin-inline: auto;
  }
  .case-testimonial :global(.case-testimonial__img) {
    width: 100%;
    height: 100%;
    min-height: 29.1875rem; /* 467px */
    object-fit: cover;
    border-radius: var(--radius-md);
  }
  .case-testimonial :global(.case-testimonial__review) {
    width: auto;
  }
</style>
