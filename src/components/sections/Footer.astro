---
import BgShapes from '../atoms/BgShapes.astro';
import Icon from '../atoms/Icon.astro';
import Logo from '../atoms/Logo.astro';
import Heading from '../atoms/Heading.astro';
import { contact, legal, socials } from '../../data/site';
import { getServices, serviceHref } from '../../lib/content';

const [firstService] = await getServices();
const pages = [
  { label: 'Home', href: '/' },
  { label: 'Projecten', href: '/projecten' },
  { label: 'Diensten', href: serviceHref(firstService.id) },
  { label: 'Over ons', href: '/over-ons' },
  { label: 'Contact', href: '/contact' },
];
---

<footer class="footer" data-theme="dark" data-theme-section="dark">
  <BgShapes leftTop={417} rightTop={-47} />
  <div class="footer__inner">
    <div class="footer__col">
      <p class="footer__label">Contactinformatie</p>
      <address class="footer__contact">
        <a href={`mailto:${contact.email}`} data-underline-link>{contact.email}</a>
        <span>{contact.address.map((line, i) => <>{i > 0 && ' '}<span>{line}</span></>)}</span>
        <a href={`tel:${contact.phone.replaceAll(' ', '')}`} data-underline-link>{contact.phone}</a>
      </address>
    </div>
    <nav class="footer__col" aria-label="Pagina’s">
      <p class="footer__label">Pagina’s</p>
      <ul class="footer__pages" role="list">
        {
          pages.map((p) => (
            <li>
              <a href={p.href} aria-label={p.label} class="footer__page">
                <Heading as="span" size="64"><span data-button-animate-chars>{p.label}</span></Heading>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <p class="footer__meta" data-local-time data-region={contact.region}>17:45 in {contact.region}</p>
    <div class="footer__meta footer__legal">
      {legal.map((l) => <a href={l.href} data-underline-link>{l.label}</a>)}
      <ul class="footer__socials" role="list">
        {socials.map((s) => <li><a href={s.href} aria-label={s.label}><Icon name={s.icon} /></a></li>)}
      </ul>
    </div>
  </div>
  <Logo variant="footer" class="footer__logo" />
</footer>

<script>
  import { studioTime, everyTick } from '../../lib/time';

  everyTick(() => {
    const { hh, mm } = studioTime();
    document.querySelectorAll<HTMLElement>('[data-local-time]').forEach((el) => {
      el.textContent = `${hh}:${mm} in ${el.dataset.region}`;
    });
  }, 1000);

  // Osmo "Button with CSS Character Stagger": split each big page link into letters with a growing delay.
  // Once per full load is enough: the footer sits outside the Swup container.
  function initButtonCharacterStagger() {
    const offsetIncrement = 0.01; // Transition offset increment in seconds
    const buttons = document.querySelectorAll('[data-button-animate-chars]');

    buttons.forEach((button) => {
      const text = button.textContent ?? ''; // Get the button's text content
      button.innerHTML = ''; // Clear the original content

      [...text].forEach((char, index) => {
        const span = document.createElement('span');
        span.textContent = char;
        span.style.transitionDelay = `${index * offsetIncrement}s`;

        // Handle spaces explicitly
        if (char === ' ') {
          span.style.whiteSpace = 'pre'; // Preserve space width
        }

        button.appendChild(span);
      });
    });
  }
  initButtonCharacterStagger();
</script>

<style>
  .footer {
    position: relative;
    height: 64.125rem; /* 1026px; the wordmark is cut off by the bottom edge */
    overflow: hidden;
  }
  /* Figma columns at x=96 (385px) and x=636 (426px) of the 1440 frame */
  .footer__inner {
    position: relative;
    display: grid;
    grid-template-columns: 33.75rem 1fr; /* 540px = 636 - 96 */
    grid-template-rows: auto 1fr;
    row-gap: 0;
    width: var(--width-content);
    height: 48.5rem; /* 776px: meta row baseline box ends at y=776 in Figma */
    margin-inline: auto;
    padding-top: 7.0625rem; /* 113px */
  }
  .footer__col {
    display: grid;
    align-content: start;
    gap: var(--space-24);
  }
  .footer__label {
    font: var(--text-label);
    color: var(--color-light-muted-on-dark);
  }
  .footer__contact {
    display: grid;
    gap: var(--space-16);
    font: var(--text-body-l-medium);
    font-style: normal;
  }
  .footer__contact span {
    display: grid;
  }
  /* grid items stretch: keep the links (and their underline) as wide as their text */
  .footer__contact > a {
    justify-self: start;
  }
  .footer__pages {
    display: grid;
    gap: var(--space-16);
  }
  /* Osmo character stagger, sized to the display type (line-height 0.9): each letter slides up and
     its copy (the text-shadow) slides in from below. Hovering one link dims the others (60%). */
  .footer__page {
    transition: opacity 0.3s var(--ease-out);
  }
  .footer [data-button-animate-chars] {
    overflow: hidden;
    position: relative;
    display: inline-block;
    vertical-align: top;
  }
  .footer [data-button-animate-chars] :global(span) {
    display: inline-block;
    position: relative;
    text-shadow: 0px 1.1em currentColor;
    transform: translateY(0em) rotate(0.001deg);
    transition: transform 0.6s var(--ease-osmo);
  }
  @media (hover: hover) and (pointer: fine) {
    .footer__page:hover [data-button-animate-chars] :global(span) {
      transform: translateY(-1.1em) rotate(0.001deg);
    }
    .footer__pages:has(.footer__page:hover) .footer__page:not(:hover) {
      opacity: 0.6;
    }
  }
  .footer__meta {
    align-self: end;
    font: var(--text-body-m-medium);
    color: var(--color-light-muted-on-dark);
  }
  .footer__legal {
    display: flex;
    align-items: center;
    gap: var(--space-16);
  }
  .footer__socials {
    display: flex;
    gap: var(--space-8);
  }
  .footer__socials a {
    display: flex;
    opacity: 0.6;
    transition: opacity 0.3s var(--ease-out);
  }
  .footer__socials a:is(:hover, :focus-visible) {
    opacity: 1;
  }
  .footer :global(.footer__logo) {
    position: absolute;
    left: 50%;
    top: 52.4375rem; /* 839px */
    width: min(100% - 48px, 87rem); /* 1392px */
    translate: -50% 0;
  }

  /* Phone/tablet (inferred): one column at content height; the wordmark follows, cut by the bottom edge */
  @media (max-width: 767px) {
    .footer {
      height: auto;
    }
    .footer__inner {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: none;
      row-gap: var(--space-48);
      height: auto;
      padding-top: var(--space-84);
    }
    .footer__meta {
      align-self: start;
    }
    .footer__legal {
      flex-wrap: wrap;
      margin-top: calc(-1 * var(--space-32));
    }
    .footer :global(.footer__logo) {
      position: relative;
      top: auto;
      display: block;
      margin: var(--space-64) 0 -4vw;
    }
  }
</style>
