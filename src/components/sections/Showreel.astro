---
import { Image } from 'astro:assets';
import BgShapes from '../atoms/BgShapes.astro';
import Heading from '../atoms/Heading.astro';
import badge from '../../assets/images/behind-the-scenes/bolt-badge.svg';
import trail1 from '../../assets/images/behind-the-scenes/koffiekoets-draaidag.jpg';
import trail2 from '../../assets/images/behind-the-scenes/fpv-drone.jpg';
import trail3 from '../../assets/images/gallery/koffiekoets-1.jpg';
import trail4 from '../../assets/images/behind-the-scenes/seat-cupra.jpg';
import trail5 from '../../assets/images/gallery/koffiekoets-2.jpg';
import trail6 from '../../assets/images/behind-the-scenes/draaidag-extra.jpg';
import trail7 from '../../assets/images/gallery/koffiekoets-3.jpg';
import trail8 from '../../assets/images/gallery/koffiekoets-4.jpg';

interface Props {
  title: string;
}

// The phone mock-up that sat on the title was hidden while the photo trail was tried out; it is
// removed now (git history has it, with its screen photo, if it comes back).
const { title } = Astro.props;
const trail = [trail1, trail2, trail3, trail4, trail5, trail6, trail7, trail8];
---

<!-- Moving the mouse over the section leaves a trail of photos (Osmo "Rotating Image Trail", scripts/image-trail.ts) -->
<section class="showreel" data-theme="dark" data-trail-area>
  <div data-trail-collection class="rotating-image-trail__collection" aria-hidden="true">
    <div class="rotating-image-trail__list">
      {
        trail.map((src) => (
          <div data-trail-item class="rotating-image-trail__item">
            <div class="rotating-image-trail__card">
              <Image src={src} alt="" width={400} class="rotating-image-trail__card-img" />
            </div>
          </div>
        ))
      }
    </div>
  </div>
  <BgShapes />
  <img class="showreel__badge showreel__badge--left" src={badge.src} width={badge.width} height={badge.height} alt="" />
  <img class="showreel__badge showreel__badge--right" src={badge.src} width={badge.width} height={badge.height} alt="" />
  <Heading size="96" class="showreel__title">{title}</Heading>
</section>

<style>
  .showreel {
    position: relative;
    display: grid;
    place-items: center;
    width: calc(100% - 2 * 14px); /* runs full width with a 14px page margin; the content keeps to the 1412px frame */
    height: 64rem; /* 1024px */
    margin: 2.9375rem auto; /* 47px above and below (Figma) */
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  /* Osmo "Rotating Image Trail" CSS. The originals sit out of flow (only measured and cloned);
     clones are placed in the section at the cursor. Global because the script makes the clones. */
  .rotating-image-trail__collection {
    position: absolute;
    top: 0;
    left: 0;
    opacity: 0;
    pointer-events: none;
  }
  .rotating-image-trail__list {
    grid-column-gap: 1em;
    grid-row-gap: 1em;
    flex-flow: wrap;
    display: flex;
  }
  .showreel :global(.rotating-image-trail__item) {
    z-index: 10;
    pointer-events: none;
    -webkit-user-select: none;
    user-select: none;
  }
  .showreel :global(.rotating-image-trail__card) {
    aspect-ratio: 3 / 4;
    width: 10vw;
    position: relative;
  }
  .showreel :global(.rotating-image-trail__card-img) {
    object-fit: cover;
    width: 100%;
    height: 100%;
    display: block;
    position: absolute;
    top: 0;
    left: 0;
  }
  .showreel :global([data-trail-item='hidden']) {
    transform: translate(-50%, -50%) scale(0) rotate(-20deg);
    position: absolute;
  }
  .showreel :global([data-trail-item='visible']) {
    transform: translate(-50%, -50%) scale(1) rotate(0.001deg);
    transition: transform 0.4s cubic-bezier(0.625, 0.05, 0, 1);
    position: absolute;
  }
  /* Calmer exit than Osmo's spin: a small shrink while it fades */
  .showreel :global([data-trail-item='transition-out']) {
    transform: translate(-50%, -50%) scale(0.85) rotate(0.001deg);
    opacity: 0;
    transition:
      transform 0.6s var(--ease-osmo),
      opacity 0.6s var(--ease-osmo);
    position: absolute;
  }
  .showreel :global(.showreel__title) {
    position: relative;
    width: var(--span-8);
    text-align: center;
  }
  .showreel__badge {
    position: absolute;
    top: 496.69px;
  }
  .showreel__badge--left {
    left: calc(max(0px, 50% - 44.125rem) + 64px);
  }
  .showreel__badge--right {
    right: calc(max(0px, 50% - 44.125rem) + 36px);
  }
  /* Phones (inferred): smaller section, bigger drifting photos, no badges */
  @media (max-width: 767px) {
    .showreel {
      height: 36rem;
      margin-block: var(--space-24);
    }
    /* The trail drifts by itself here (image-trail.ts): bigger photos, passing behind the title */
    .showreel :global(.rotating-image-trail__card) {
      width: 34vw;
    }
    .showreel :global(.showreel__title) {
      z-index: 11;
      width: var(--span-4);
    }
    .showreel__badge {
      display: none;
    }
  }
</style>
