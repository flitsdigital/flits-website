---
import type { CollectionEntry } from 'astro:content';
import SectionHeader from '../molecules/SectionHeader.astro';
import ServiceCard from '../molecules/ServiceCard.astro';
import { serviceHref } from '../../lib/content';

interface Props {
  title: string;
  ticker?: string[];
  /** Services that have a teaser image (see getTeaserServices). */
  services: CollectionEntry<'services'>[];
}

const { title, ticker, services } = Astro.props;
---

<section class="services">
  <SectionHeader title={title} ticker={ticker} span={8} gap={28} />
  <div class="services__grid">
    {
      services.map((s) => (
        <ServiceCard href={serviceHref(s.id)} image={s.data.teaserImage!} label={s.data.teaserLabel ?? s.data.label} />
      ))
    }
  </div>
</section>

<style>
  .services {
    padding-bottom: var(--section-space-l);
  }
  .services__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--grid-gap); /* two cards of 6 columns */
    width: var(--grid-width);
    margin-inline: auto; /* not tucked into the header's padding: the boxes would overlap */
  }

  @media (max-width: 767px) {
    .services__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--grid-gap);
    }
  }
</style>
