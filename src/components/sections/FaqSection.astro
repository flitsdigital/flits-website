---
import SectionHeader from '../molecules/SectionHeader.astro';
import Panel from '../atoms/Panel.astro';
import BgShapes from '../atoms/BgShapes.astro';
import Button from '../atoms/Button.astro';
import FaqItem from '../molecules/FaqItem.astro';

interface Props {
  title: string;
  lead: string;
  faqs: { question: string; answer: string }[];
}

const { title, lead, faqs } = Astro.props;
---

<!-- Figma 1:2452: dark 1344×788 panel, header left, accordion right, "Nog vragen?" under the list -->
<section class="faq-section">
  <Panel theme="dark">
    <BgShapes leftTop={254} rightTop={-237} leftX={-672 - 169.5} rightX={-672 + 718} />
    <div class="faq">
      <SectionHeader title={title} lead={lead} span={6} align="start" spaced={false} />
      <div class="faq__list">
        <ul class="faq__items" data-accordion-css-init data-accordion-close-siblings="true">
          {
            faqs.map((f) => (
              <FaqItem question={f.question}>
                <p>{f.answer}</p>
              </FaqItem>
            ))
          }
        </ul>
        <p class="faq__more">
          <span>Nog vragen?</span>
          <Button href="/contact">Neem contact op</Button>
        </p>
      </div>
    </div>
  </Panel>
</section>

<style>
  /* 72px under a steps panel (48px margin there + 24px here); 64px to the footer */
  .faq-section {
    margin-block: var(--space-24) var(--space-64);
  }
  .faq {
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr)); /* header 6 columns · questions 6 columns */
    align-items: start;
    gap: var(--grid-gap);
    width: var(--grid-width);
    margin-inline: auto;
    padding-block: 6.0625rem 4.75rem; /* 97px top, 76px under the CTA */
  }
  .faq__list,
  .faq__items {
    display: grid;
    gap: var(--space-20);
  }
  .faq__items {
    margin: 0;
    padding: 0;
  }
  .faq__more {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: var(--space-16);
    margin-top: 1.8125rem; /* 49px under the last question (incl. the 20px gap) */
    font: var(--text-ui);
    color: var(--color-light-100-80);
  }
  /* Phone: header above the questions */
  @media (max-width: 767px) {
    .faq {
      grid-template-columns: minmax(0, 1fr);
      padding-block: var(--space-64);
    }
  }
</style>
