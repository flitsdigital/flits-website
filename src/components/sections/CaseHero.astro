---
import type { ImageMetadata } from 'astro';
import BgShapes from '../atoms/BgShapes.astro';
import PhotoBackdrop from '../atoms/PhotoBackdrop.astro';
import bolt from '../../assets/images/case/bolt.svg';

interface Props {
  image: ImageMetadata;
  client: string;
  year: string;
  title: string;
}

const { image, client, year, title } = Astro.props;
---

<!-- Figma 1:3145–1:3155: full-bleed photo under a 40% veil, one dark bolt, client · year and the title at the bottom -->
<section class="case-hero" data-theme="dark">
  <PhotoBackdrop image={image} veil="dark" />
  <BgShapes rightOnly />
  <div class="case-hero__text">
    <p class="case-hero__meta">{client}{' '}<img src={bolt.src} width={bolt.width} height={bolt.height} alt="" />{' '}{year}</p>
    <h1>{title}</h1>
  </div>
</section>

<style>
  .case-hero {
    position: relative;
    isolation: isolate; /* own stacking context, so hero media can overlap it */
    display: grid;
    justify-items: center;
    align-content: end;
    min-height: 60.5rem; /* 968px */
    padding: var(--page-top) var(--gutter) 7.4375rem; /* title ends 119px above the bottom */
    overflow: hidden;
    text-align: center;
  }
  .case-hero__text {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 1.375rem; /* 22px */
    width: min(100%, 45.1875rem); /* 723px */
    color: var(--color-light-0);
  }
  .case-hero__meta {
    display: flex;
    align-items: center;
    gap: var(--space-16);
    font: var(--text-body-l-medium);
    line-height: 0.9;
    letter-spacing: var(--tracking-display);
  }
  h1 {
    font: var(--text-title-medium-64);
    letter-spacing: var(--tracking-display);
  }
</style>
