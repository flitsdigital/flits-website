---
import SectionHeader from '../molecules/SectionHeader.astro';
import type { ImageMetadata } from 'astro';
import Panel from '../atoms/Panel.astro';
import Eyebrow from '../molecules/Eyebrow.astro';
import StatCard from '../molecules/StatCard.astro';

interface Props {
  avatars: { src: ImageMetadata; alt?: string }[];
  eyebrow: string;
  title: string;
  lead: string;
  stats: { label: string; value: string }[];
}

const { avatars, eyebrow, title, lead, stats } = Astro.props;
---

<!-- Figma 1:1751 (over ons) and 1:3234 (case): white panel, intro in the 817 column, three stat cards -->
<Panel as="section">
  <div class="stats-panel">
    <SectionHeader title={title} lead={lead} span={8} gap={24} align="start" spaced={false}>
      <Eyebrow slot="eyebrow" avatars={avatars} size="l" tone="default">{eyebrow}</Eyebrow>
    </SectionHeader>
    <dl class="stats-panel__stats" data-odometer-group>
      {stats.map((s) => <StatCard {...s} />)}
    </dl>
  </div>
</Panel>

<style>
  .stats-panel {
    display: grid;
    /* shortcut: Figma has 94px (over ons) vs 80px (case) here and 53/39px at the bottom; one rhythm for both */
    gap: 5.5rem; /* 88px */
    padding-block: var(--space-96) var(--space-48);
  }
  .stats-panel__stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr)); /* 4 columns each */
    gap: var(--grid-gap);
    width: var(--grid-width);
    margin-inline: auto;
  }
  /* Phone: three across doesn't fit 4 columns, so the cards stack */
  @media (max-width: 767px) {
    .stats-panel__stats {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
