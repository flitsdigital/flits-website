---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getServices, getCaseSlugs, projectHref, serviceHref } from '../lib/content';

// Living overview (fase 3 review route): since fase 4 the real pages are the section showcase.
// Each row lists the sections a page is built from, in order.
const services = await getServices();
const cases = await getCaseSlugs();
const routes = [
  { href: '/', label: 'Home', sections: 'HeroHome + ImageFan · IntroLogos · ProjectsGrid · ReviewsCarousel · ServicesTeaser · TeamSection · Showreel' },
  { href: '/over-ons', label: 'Over ons', sections: 'HeroPhoto + ImageFan · TextBlock · StatsPanel · TeamSection (light) · ClientLogoGrid · BehindTheScenes · ReviewsCarousel' },
  { href: '/projecten', label: 'Projecten', sections: 'HeroPage · ProjectArchive' },
  ...cases.map((slug) => ({ href: projectHref(slug), label: `Case: ${slug}`, sections: 'CaseHero · CaseIntro · VideoFan · CaseGallery · CaseResults · StatsPanel · CaseTestimonial · ProjectsGrid' })),
  ...services.map((s) => ({ href: serviceHref(s.id), label: `Dienst: ${s.data.label}`, sections: s.data.page.blocks.map((b) => b.type).join(' · ') })),
  { href: '/contact', label: 'Contact', sections: 'HeroPage · ContactSection' },
  { href: '/404', label: '404', sections: 'HeroPage · ProjectsGrid' },
];
---

<BaseLayout title="Sections — Flits" noindex>
  <main class="sections-index">
    <h1>Pagina's en hun secties</h1>
    <p>Design-system: <a href="/styleguide">/styleguide</a> · <a href="/components">/components</a></p>
    <ul>
      {routes.map((r) => <li><a href={r.href}>{r.label}</a><span>{r.sections}</span></li>)}
    </ul>
  </main>
</BaseLayout>

<style>
  .sections-index {
    width: var(--width-content);
    margin-inline: auto;
    padding-block: var(--space-96);
    display: grid;
    gap: var(--space-24);
  }
  h1 {
    font: var(--text-display-36);
    text-transform: uppercase;
  }
  ul {
    display: grid;
    gap: var(--space-16);
  }
  li {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-16);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
  }
  a {
    font: var(--text-body-l);
    text-decoration: underline;
  }
  span {
    font: var(--text-body-desc);
    color: var(--color-text-muted);
  }
</style>
