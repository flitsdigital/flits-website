---
// entry-animations branch only: a timeline to fine-tune home entry variant 13 by hand.
// The real home page runs in the iframe; this page writes --t13-* variables onto its <html>
// (and to localStorage, which BaseLayout reads on ?tune) and drives every animation's time itself.
import '../styles/tokens.css';
import '../styles/fonts.css';
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Entree 13 · tuner</title>
  </head>
  <body>
    <header class="bar">
      <strong>Entree 13 · tuner</strong>
      <div class="transport">
        <button data-act="restart" title="Naar 0 en afspelen (R)">⟲</button>
        <button data-act="play" class="play" title="Afspelen / pauze (spatie)">▶</button>
        <span class="time" data-time>0.00s</span>
        <label class="check"><input type="checkbox" data-loop checked /> Herhalen</label>
        <div class="seg" data-speed>
          <button data-rate="0.25">¼×</button>
          <button data-rate="0.5">½×</button>
          <button data-rate="1" aria-pressed="true">1×</button>
        </div>
      </div>
      <div class="actions">
        <button data-act="reload" title="Laad de pagina opnieuw (zoals een echte eerste keer)">Herlaad pagina</button>
        <button data-act="reset">Standaard</button>
        <button data-act="copy" class="primary">Kopieer waarden</button>
      </div>
    </header>

    <main class="stage" data-stage>
      <iframe src="/?entry=13&tune" title="Homepage" data-frame></iframe>
    </main>

    <section class="panel">
      <div class="timeline" data-timeline>
        <div class="ruler" data-ruler></div>
        <div class="rows" data-rows></div>
        <div class="playhead" data-playhead></div>
      </div>
      <aside class="inspector" data-inspector></aside>
    </section>

    <div class="toast" data-toast hidden></div>

    <script>
      type Extra = { id: string; label: string; unit: string; min: number; max: number; step: number; value: number };
      type Track = {
        id: string;
        label: string;
        hint?: string;
        gsap?: boolean;
        delay: number;
        dur: number;
        ease: number[];
        extras?: Extra[];
      };

      const KEY = 'flits-tune-13';
      const EASES: Record<string, number[]> = {
        osmo: [0.625, 0.05, 0, 1],
        'ease-out (site)': [0.22, 1, 0.36, 1],
        expo: [0.16, 1, 0.3, 1],
        'in-out': [0.65, 0, 0.35, 1],
        linear: [0, 0, 1, 1],
      };
      const OSMO = EASES.osmo;
      // Defaults = the --t13-* block in entry-variants.css
      const DEFAULTS: Track[] = [
        { id: 'wipe', label: 'Donkere achtergrond', hint: 'clip-path van boven naar beneden', delay: 0, dur: 1, ease: OSMO },
        {
          id: 'focus',
          label: 'Hero-content (lens)',
          hint: 'vervaagd en iets groter → scherp',
          delay: 0,
          dur: 1.3,
          ease: OSMO,
          extras: [
            { id: 'blur', label: 'Blur', unit: 'px', min: 0, max: 40, step: 1, value: 18 },
            { id: 'scale', label: 'Startschaal', unit: '', min: 0.9, max: 1.2, step: 0.01, value: 1.05 },
          ],
        },
        {
          id: 'left',
          label: '"Wij maken"',
          hint: 'schuift in van links',
          delay: 0,
          dur: 1.3,
          ease: OSMO,
          extras: [{ id: 'dist', label: 'Afstand', unit: 'vw', min: 0, max: 40, step: 0.5, value: 10 }],
        },
        { id: 'bar', label: 'Gele balk', hint: 'clip-path van links naar rechts', delay: 0.18, dur: 0.8, ease: OSMO },
        {
          id: 'letters',
          label: 'Letters IMPACT',
          hint: 'per letter omhoog, na elkaar',
          delay: 0.3,
          dur: 0.6,
          ease: OSMO,
          extras: [
            { id: 'stagger', label: 'Tijd tussen letters', unit: 's', min: 0, max: 0.2, step: 0.005, value: 0.03 },
            { id: 'rise', label: 'Hoogte', unit: '%', min: 0, max: 150, step: 5, value: 40 },
          ],
        },
        {
          id: 'bolts',
          label: 'Bliksems',
          hint: 'schuiven in vanaf de zijkanten',
          delay: 0,
          dur: 1.5,
          ease: OSMO,
          extras: [{ id: 'dist', label: 'Afstand', unit: 'vw', min: 0, max: 40, step: 0.5, value: 12 }],
        },
        { id: 'nav', label: 'Navbar', hint: 'fade', delay: 0.2, dur: 0.8, ease: OSMO },
        { id: 'fanfade', label: "Foto's · opacity", hint: 'fade van de hele cirkel', delay: 0.9, dur: 0.6, ease: OSMO },
        {
          id: 'turn',
          label: "Foto's · draai",
          hint: 'GSAP: start live iets later dan de CSS (bij het laden van het script); wijzigen herlaadt de pagina',
          gsap: true,
          delay: 0.7,
          dur: 1.2,
          ease: OSMO,
          extras: [{ id: 'steps', label: "Afstand (aantal foto's)", unit: '', min: 0, max: 6, step: 0.5, value: 2 }],
        },
      ];

      const $ = <T extends Element = HTMLElement>(sel: string) => document.querySelector(sel) as T;
      const frame = $<HTMLIFrameElement>('[data-frame]');
      const rowsEl = $('[data-rows]');
      const ruler = $('[data-ruler]');
      const playheadEl = $('[data-playhead]');
      const inspector = $('[data-inspector]');
      const timeEl = $('[data-time]');
      const playBtn = $('.play');

      const clone = (t: Track[]) => JSON.parse(JSON.stringify(t)) as Track[];
      const round = (n: number, step = 0.01) => Math.round(n / step) * step;
      const fmt = (n: number) => +n.toFixed(3);
      const bezier = (e: number[]) => `cubic-bezier(${e.map(fmt).join(', ')})`;

      // ---------- state <-> CSS variables ----------
      const varsOf = (t: Track) => {
        const s = t.gsap ? '' : 's';
        const vars: Record<string, string> = {
          [`--t13-${t.id}-delay`]: `${fmt(t.delay)}${s}`,
          [`--t13-${t.id}-dur`]: `${fmt(t.dur)}${s}`,
          [`--t13-${t.id}-ease`]: bezier(t.ease),
        };
        t.extras?.forEach((x) => (vars[`--t13-${t.id}-${x.id}`] = `${fmt(x.value)}${x.unit}`));
        return vars;
      };
      const allVars = () => Object.assign({}, ...tracks.map(varsOf)) as Record<string, string>;

      const load = (): Track[] => {
        const t = clone(DEFAULTS);
        try {
          const saved = JSON.parse(localStorage.getItem(KEY) || '{}');
          t.forEach((tr) => {
            const get = (k: string) => saved[`--t13-${tr.id}-${k}`];
            if (get('delay') != null) tr.delay = parseFloat(get('delay'));
            if (get('dur') != null) tr.dur = parseFloat(get('dur'));
            const e = get('ease')?.match(/cubic-bezier\(([^)]+)\)/);
            if (e) tr.ease = e[1].split(',').map(parseFloat);
            tr.extras?.forEach((x) => get(x.id) != null && (x.value = parseFloat(get(x.id))));
          });
        } catch {}
        return t;
      };

      let tracks = load();
      let selected = tracks[0].id;
      let reloadTimer: number | undefined;

      const save = () => {
        try {
          localStorage.setItem(KEY, JSON.stringify(allVars()));
        } catch {}
      };
      const applyLive = (track: Track) => {
        const html = frame.contentDocument?.documentElement;
        if (!html) return;
        Object.entries(varsOf(track)).forEach(([k, v]) => html.style.setProperty(k, v));
        if (track.gsap) {
          // the GSAP tween reads its settings once, when the slider starts: reload the page
          clearTimeout(reloadTimer);
          reloadTimer = window.setTimeout(() => frame.contentWindow?.location.reload(), 350);
        }
        seek(t);
      };
      // `inspector: false` when the change comes from an inspector control itself (rebuilding would drop the drag)
      const changed = (track: Track, inspector = true) => {
        save();
        applyLive(track);
        renderRows();
        if (inspector) renderInspector();
      };

      // ---------- time ----------
      let t = 0;
      let playing = false;
      let rate = 1;
      let last = 0;
      let holdUntil = 0;
      const end = () => Math.max(...tracks.map((tr) => tr.delay + tr.dur + (tr.id === 'letters' ? 5 * extra(tr, 'stagger') : 0)));
      const span = () => Math.max(2.5, Math.ceil((end() + 0.3) * 2) / 2);
      function extra(tr: Track, id: string) {
        return tr.extras?.find((x) => x.id === id)?.value ?? 0;
      }

      function seek(time: number) {
        t = Math.max(0, time);
        timeEl.textContent = `${t.toFixed(2)}s`;
        playheadEl.style.setProperty('--x', String(t / span()));
        const doc = frame.contentDocument;
        const win = frame.contentWindow as (Window & typeof globalThis) | null;
        if (!doc || !win || !doc.documentElement.hasAttribute('data-tune')) return;
        doc.getAnimations().forEach((a) => {
          if (a instanceof win.CSSAnimation && a.effect?.getComputedTiming().endTime !== Infinity) a.currentTime = t * 1000;
        });
        const tween = (doc.querySelector('.hero-media [data-radial-slider-init]') as any)?.radialIntro;
        if (tween) {
          tween.pause();
          tween.totalTime(Math.min(Math.max(t - tween.delay(), 0), tween.duration()));
        }
      }

      function loop(now: number) {
        if (playing) {
          const dt = (now - last) / 1000;
          if (now >= holdUntil) {
            const next = t + dt * rate;
            if (next >= end()) {
              seek(end());
              if ($<HTMLInputElement>('[data-loop]').checked) {
                holdUntil = now + 900; // look at the end state for a moment, then go again
                t = -1;
              } else setPlaying(false);
            } else seek(t < 0 ? 0 : next);
          }
        }
        last = now;
        requestAnimationFrame(loop);
      }
      requestAnimationFrame((now) => {
        last = now;
        loop(now);
      });

      function setPlaying(on: boolean) {
        playing = on;
        holdUntil = 0;
        if (on && (t < 0 || t >= end())) t = 0;
        playBtn.textContent = on ? '❚❚' : '▶';
      }

      frame.addEventListener('load', () => {
        seek(t < 0 ? 0 : t);
        if (!playing && t === 0) setPlaying(true);
      });

      // ---------- timeline ----------
      function renderRuler() {
        const s = span();
        ruler.innerHTML = '';
        for (let i = 0; i <= s * 10 + 1e-6; i++) {
          const tick = document.createElement('span');
          tick.className = i % 5 === 0 ? 'tick major' : 'tick';
          tick.style.setProperty('--x', String(i / 10 / s));
          if (i % 5 === 0) tick.textContent = `${(i / 10).toFixed(1)}s`;
          ruler.append(tick);
        }
      }

      function renderRows() {
        const s = span();
        renderRuler();
        if (!rowsEl.children.length) {
          tracks.forEach((tr) => {
            const row = document.createElement('div');
            row.className = 'row';
            row.dataset.id = tr.id;
            row.innerHTML = `<button class="name"><b></b><small></small></button>
              <div class="lane"><div class="clip"><span class="h start"></span><span class="label"></span><span class="h end"></span></div></div>`;
            rowsEl.append(row);
          });
        }
        tracks.forEach((tr) => {
          const row = rowsEl.querySelector<HTMLElement>(`[data-id="${tr.id}"]`)!;
          row.classList.toggle('is-selected', tr.id === selected);
          row.querySelector('b')!.textContent = tr.label;
          row.querySelector('small')!.textContent = `${fmt(tr.delay)}s → ${fmt(tr.dur)}s`;
          const clip = row.querySelector<HTMLElement>('.clip')!;
          const tail = tr.id === 'letters' ? 5 * extra(tr, 'stagger') : 0;
          clip.style.setProperty('--x', String(tr.delay / s));
          clip.style.setProperty('--w', String(tr.dur / s));
          clip.style.setProperty('--tail', String(tail / s));
          clip.classList.toggle('gsap', !!tr.gsap);
          clip.querySelector('.label')!.textContent = easeName(tr.ease);
        });
        playheadEl.style.setProperty('--x', String(t / s));
      }

      const easeName = (e: number[]) =>
        Object.entries(EASES).find(([, v]) => v.every((n, i) => Math.abs(n - e[i]) < 1e-4))?.[0] ?? 'custom';

      // drag a bar: body moves the start, the edges change start or length (0.01s steps)
      rowsEl.addEventListener('pointerdown', (ev) => {
        const target = ev.target as HTMLElement;
        const row = target.closest<HTMLElement>('.row');
        if (!row) return;
        const tr = tracks.find((x) => x.id === row.dataset.id)!;
        selected = tr.id;
        renderRows();
        renderInspector();
        const lane = row.querySelector<HTMLElement>('.lane')!;
        if (!lane.contains(target)) return;
        const pxPerSec = lane.getBoundingClientRect().width / span();
        if (!target.closest('.clip')) return scrub(ev);
        const mode = target.classList.contains('end') ? 'end' : target.classList.contains('start') ? 'start' : 'move';
        const start = { x: ev.clientX, delay: tr.delay, dur: tr.dur };
        target.setPointerCapture(ev.pointerId);
        const move = (e: PointerEvent) => {
          const d = (e.clientX - start.x) / pxPerSec;
          if (mode === 'move') tr.delay = Math.max(0, round(start.delay + d));
          if (mode === 'end') tr.dur = Math.max(0.05, round(start.dur + d));
          if (mode === 'start') {
            tr.delay = Math.min(Math.max(0, round(start.delay + d)), start.delay + start.dur - 0.05);
            tr.dur = round(start.delay + start.dur - tr.delay);
          }
          save();
          applyLive(tr);
          renderRows();
          renderInspector();
        };
        target.addEventListener('pointermove', move);
        target.addEventListener('pointerup', () => target.removeEventListener('pointermove', move), { once: true });
      });

      // click or drag on the ruler / an empty lane: scrub
      function scrub(ev: PointerEvent) {
        setPlaying(false);
        const lane = ($('.row .lane') as HTMLElement).getBoundingClientRect();
        const at = (x: number) => seek(round(((x - lane.left) / lane.width) * span(), 0.005));
        at(ev.clientX);
        const el = ev.target as HTMLElement;
        el.setPointerCapture(ev.pointerId);
        const move = (e: PointerEvent) => at(e.clientX);
        el.addEventListener('pointermove', move);
        el.addEventListener('pointerup', () => el.removeEventListener('pointermove', move), { once: true });
      }
      ruler.addEventListener('pointerdown', scrub);

      // ---------- inspector ----------
      function field(label: string, value: number, opts: { min: number; max: number; step: number; unit: string }, on: (v: number) => void) {
        const wrap = document.createElement('label');
        wrap.className = 'field';
        wrap.innerHTML = `<span>${label}</span><input type="range" min="${opts.min}" max="${opts.max}" step="${opts.step}" value="${value}" />
          <span class="num"><input type="number" min="${opts.min}" step="${opts.step}" value="${fmt(value)}" /><i>${opts.unit}</i></span>`;
        const [range, num] = wrap.querySelectorAll('input');
        range.addEventListener('input', () => {
          num.value = String(fmt(+range.value));
          on(+range.value);
        });
        num.addEventListener('change', () => {
          if (Number.isNaN(parseFloat(num.value))) return;
          range.value = num.value;
          on(parseFloat(num.value));
        });
        return wrap;
      }

      function curve(e: number[]) {
        const [a, b, c, d] = e;
        const y = (v: number) => 100 - v * 100;
        return `<svg viewBox="-10 -30 120 160" class="curve" aria-hidden="true">
          <rect x="0" y="0" width="100" height="100" />
          <line x1="0" y1="100" x2="${a * 100}" y2="${y(b)}" /><line x1="100" y1="0" x2="${c * 100}" y2="${y(d)}" />
          <path d="M0,100 C${a * 100},${y(b)} ${c * 100},${y(d)} 100,0" />
        </svg>`;
      }

      function renderInspector() {
        const tr = tracks.find((x) => x.id === selected)!;
        inspector.innerHTML = `<h2>${tr.label}</h2>${tr.hint ? `<p class="hint">${tr.hint}</p>` : ''}`;
        const add = (el: HTMLElement) => inspector.append(el);
        add(field('Start', tr.delay, { min: 0, max: 3, step: 0.01, unit: 's' }, (v) => ((tr.delay = Math.max(0, v)), changed(tr, false))));
        add(field('Duur', tr.dur, { min: 0.05, max: 3, step: 0.01, unit: 's' }, (v) => ((tr.dur = Math.max(0.05, v)), changed(tr, false))));

        const ease = document.createElement('div');
        ease.className = 'ease';
        const name = easeName(tr.ease);
        ease.innerHTML = `<span>Easing</span>
          <select>${Object.keys(EASES)
            .map((k) => `<option ${k === name ? 'selected' : ''}>${k}</option>`)
            .join('')}<option ${name === 'custom' ? 'selected' : ''} disabled>custom</option></select>
          <div class="bez">${tr.ease.map((v, i) => `<input type="number" step="0.01" value="${fmt(v)}" data-i="${i}" aria-label="punt ${i + 1}" />`).join('')}</div>
          ${curve(tr.ease)}`;
        ease.querySelector('select')!.addEventListener('change', (e) => {
          tr.ease = [...EASES[(e.target as HTMLSelectElement).value]];
          changed(tr);
        });
        ease.querySelectorAll<HTMLInputElement>('.bez input').forEach((inp) =>
          inp.addEventListener('change', () => {
            const v = parseFloat(inp.value);
            if (Number.isNaN(v)) return;
            const i = +inp.dataset.i!;
            tr.ease[i] = i % 2 === 0 ? Math.min(1, Math.max(0, v)) : v; // x stays within 0–1
            changed(tr);
          }),
        );
        add(ease);

        tr.extras?.forEach((x) => add(field(x.label, x.value, x, (v) => ((x.value = v), changed(tr, false)))));
      }

      // ---------- header ----------
      document.querySelector('.bar')!.addEventListener('click', async (ev) => {
        const btn = (ev.target as HTMLElement).closest('button');
        if (!btn) return;
        const act = btn.dataset.act;
        if (btn.dataset.rate) {
          rate = +btn.dataset.rate;
          document.querySelectorAll('[data-rate]').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        }
        if (act === 'play') setPlaying(!playing);
        if (act === 'restart') {
          seek(0);
          setPlaying(true);
        }
        if (act === 'reload') {
          t = 0;
          frame.contentWindow?.location.reload();
        }
        if (act === 'reset' && confirm('Alle waarden terug naar de standaard van variant 13?')) {
          tracks = clone(DEFAULTS);
          save();
          frame.contentWindow?.location.reload();
          renderRows();
          renderInspector();
        }
        if (act === 'copy') {
          const text = `/* Entree 13 — waarden uit /tune */\n${Object.entries(allVars())
            .map(([k, v]) => `${k}: ${v};`)
            .join('\n')}`;
          try {
            await navigator.clipboard.writeText(text);
            toast('Gekopieerd — plak het in de chat');
          } catch {
            prompt('Kopieer deze waarden:', text);
          }
        }
      });

      document.addEventListener('keydown', (e) => {
        if ((e.target as HTMLElement).closest('input, select')) return;
        if (e.code === 'Space') {
          e.preventDefault();
          setPlaying(!playing);
        }
        if (e.key === 'r') {
          seek(0);
          setPlaying(true);
        }
        if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
          setPlaying(false);
          seek(t + (e.key === 'ArrowRight' ? 1 : -1) * (e.shiftKey ? 0.1 : 1 / 60));
        }
      });

      function toast(msg: string) {
        const el = $('[data-toast]');
        el.textContent = msg;
        el.hidden = false;
        setTimeout(() => (el.hidden = true), 2200);
      }

      // ---------- stage: the page at 1440×900, scaled to fit ----------
      const stage = $('[data-stage]');
      new ResizeObserver(() => {
        const { width, height } = stage.getBoundingClientRect();
        stage.style.setProperty('--scale', String(Math.min(width / 1440, height / 900)));
      }).observe(stage);

      renderRows();
      renderInspector();
    </script>

    <style is:global>
      * {
        box-sizing: border-box;
      }
      html,
      body {
        margin: 0;
        height: 100%;
      }
      body {
        display: grid;
        grid-template-rows: auto minmax(0, 1fr) auto;
        background: #0d0110;
        color: var(--color-light-0);
        font: 13px/1.4 var(--font-body);
      }
      button,
      input,
      select {
        font: inherit;
        color: inherit;
      }
      button {
        border: 1px solid rgb(255 255 255 / 0.15);
        background: rgb(255 255 255 / 0.06);
        border-radius: 8px;
        padding: 6px 12px;
        cursor: pointer;
      }
      button:hover {
        background: rgb(255 255 255 / 0.12);
      }
      button.primary,
      button[aria-pressed='true'] {
        background: var(--color-brand-500);
        color: var(--color-dark-900);
        border-color: transparent;
      }

      .bar {
        display: flex;
        align-items: center;
        gap: 24px;
        padding: 10px 16px;
        border-bottom: 1px solid rgb(255 255 255 / 0.1);
      }
      .transport,
      .actions {
        display: flex;
        align-items: center;
        gap: 8px;
      }
      .actions {
        margin-left: auto;
      }
      .play {
        min-width: 44px;
      }
      .time {
        min-width: 56px;
        font-variant-numeric: tabular-nums;
        color: var(--color-brand-500);
      }
      .check {
        display: flex;
        gap: 6px;
        align-items: center;
      }
      .seg {
        display: flex;
        gap: 2px;
      }

      .stage {
        position: relative;
        overflow: hidden;
        background: #050006;
      }
      .stage iframe {
        position: absolute;
        left: 50%;
        top: 50%;
        width: 1440px;
        height: 900px;
        border: 0;
        translate: -50% -50%;
        scale: var(--scale, 0.5);
        box-shadow: 0 0 0 1px rgb(255 255 255 / 0.1);
      }

      .panel {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 380px;
        border-top: 1px solid rgb(255 255 255 / 0.1);
        --label-w: 190px;
      }
      .timeline {
        position: relative;
        padding: 0 16px 12px;
        user-select: none;
      }
      .ruler {
        position: relative;
        height: 28px;
        margin-left: var(--label-w);
        cursor: ew-resize;
      }
      .tick {
        position: absolute;
        left: calc(var(--x) * 100%);
        bottom: 0;
        height: 6px;
        border-left: 1px solid rgb(255 255 255 / 0.2);
        font-size: 11px;
        color: rgb(255 255 255 / 0.5);
      }
      .tick.major {
        height: 22px;
        padding-left: 4px;
        border-color: rgb(255 255 255 / 0.4);
      }
      .row {
        display: grid;
        grid-template-columns: var(--label-w) minmax(0, 1fr);
        height: 32px;
        align-items: center;
      }
      .row .name {
        all: unset;
        cursor: pointer;
        display: flex;
        flex-direction: column;
        line-height: 1.15;
        padding-right: 12px;
      }
      .row .name small {
        color: rgb(255 255 255 / 0.45);
        font-variant-numeric: tabular-nums;
      }
      .row.is-selected .name b {
        color: var(--color-brand-500);
      }
      .lane {
        position: relative;
        height: 100%;
        border-top: 1px solid rgb(255 255 255 / 0.06);
        cursor: ew-resize;
      }
      .clip {
        position: absolute;
        top: 5px;
        bottom: 5px;
        left: calc(var(--x) * 100%);
        width: calc((var(--w) + var(--tail)) * 100%);
        min-width: 8px;
        border-radius: 6px;
        background: linear-gradient(90deg, #6b4f9e calc(var(--w) / (var(--w) + var(--tail)) * 100%), #4a3670 0);
        cursor: grab;
        display: flex;
        align-items: center;
      }
      .clip.gsap {
        background: linear-gradient(90deg, #2f7d6d, #2f7d6d);
      }
      .row.is-selected .clip {
        outline: 2px solid var(--color-brand-500);
      }
      .clip .label {
        flex: 1;
        padding: 0 10px;
        font-size: 11px;
        white-space: nowrap;
        overflow: hidden;
        pointer-events: none;
        color: rgb(255 255 255 / 0.8);
      }
      .clip .h {
        width: 8px;
        align-self: stretch;
        cursor: col-resize;
      }
      .clip .h:hover {
        background: rgb(255 255 255 / 0.25);
      }
      .playhead {
        position: absolute;
        top: 0;
        bottom: 12px;
        left: calc(16px + var(--label-w) + var(--x, 0) * (100% - 32px - var(--label-w)));
        width: 0;
        border-left: 2px solid var(--color-brand-500);
        pointer-events: none;
      }

      .inspector {
        border-left: 1px solid rgb(255 255 255 / 0.1);
        padding: 12px 16px;
        display: grid;
        gap: 10px;
        align-content: start;
        max-height: 340px;
        overflow: auto;
      }
      .inspector h2 {
        margin: 0;
        font-size: 15px;
      }
      .hint {
        margin: -6px 0 0;
        color: rgb(255 255 255 / 0.5);
      }
      .field,
      .ease {
        display: grid;
        grid-template-columns: 96px minmax(0, 1fr) 84px;
        gap: 8px;
        align-items: center;
      }
      .num {
        display: flex;
        align-items: center;
        gap: 4px;
      }
      .num input,
      .bez input {
        width: 100%;
        min-width: 0;
        font-variant-numeric: tabular-nums;
        background: rgb(255 255 255 / 0.06);
        border: 1px solid rgb(255 255 255 / 0.15);
        border-radius: 6px;
        padding: 3px 6px;
      }
      .num i {
        font-style: normal;
        color: rgb(255 255 255 / 0.5);
        width: 1.5em;
      }
      input[type='range'] {
        accent-color: var(--color-brand-500);
      }
      .ease select {
        grid-column: span 2;
        background: #1d0c21;
        border: 1px solid rgb(255 255 255 / 0.15);
        border-radius: 6px;
        padding: 4px;
      }
      .bez {
        grid-column: 1 / 4;
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 4px;
      }
      .curve {
        grid-column: 2 / 4;
        width: 100%;
        max-height: 120px;
        fill: none;
      }
      .curve rect {
        stroke: rgb(255 255 255 / 0.15);
      }
      .curve line {
        stroke: rgb(255 255 255 / 0.35);
      }
      .curve path {
        stroke: var(--color-brand-500);
        stroke-width: 2.5;
      }

      .toast {
        position: fixed;
        bottom: 16px;
        left: 50%;
        translate: -50% 0;
        background: var(--color-brand-500);
        color: var(--color-dark-900);
        padding: 8px 14px;
        border-radius: 999px;
      }
    </style>
  </body>
</html>
