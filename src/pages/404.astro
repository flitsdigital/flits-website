---
import PageLayout from '../layouts/PageLayout.astro';
import HeroPage from '../components/sections/HeroPage.astro';
import ProjectsGrid from '../components/sections/ProjectsGrid.astro';
import { getProjects } from '../lib/content';

// 404: no Figma page. The page hero + the latest projects, so a lost visitor still lands somewhere useful.
const projects = (await getProjects()).slice(0, 4);
---

<PageLayout title="Pagina niet gevonden — Flits" noindex>
  <HeroPage
    size="m"
    breadcrumb={[{ label: 'Niet gevonden' }]}
    title="Deze pagina bestaat niet"
    intro={['De link klopt niet (meer). Bekijk hieronder ons werk, of ga terug naar de homepagina.']}
  />
  <ProjectsGrid title="Bekijk onze projecten" projects={projects} />
</PageLayout>
