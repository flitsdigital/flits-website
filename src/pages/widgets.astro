---
import BaseLayout from '../layouts/BaseLayout.astro';
import Heading from '../components/atoms/Heading.astro';
import Text from '../components/atoms/Text.astro';
import WeatherWidget from '../components/molecules/WeatherWidget.astro';
import ClockWidget from '../components/molecules/ClockWidget.astro';
import MapWidget from '../components/molecules/MapWidget.astro';
import SpotifyWidget from '../components/molecules/SpotifyWidget.astro';
import ChristmasWidget from '../components/molecules/ChristmasWidget.astro';
import { allScenes } from '../lib/weather';
import { pools, fixed, slots } from '../data/widgets';
import WidgetSlot from '../components/molecules/WidgetSlot.astro';
import PageSpeedWidget from '../components/molecules/PageSpeedWidget.astro';
import ReviewsWidget from '../components/molecules/ReviewsWidget.astro';
import OfficeWidget from '../components/molecules/OfficeWidget.astro';
import StoriesWidget from '../components/molecules/StoriesWidget.astro';
import StudioPostWidget from '../components/molecules/StudioPostWidget.astro';
import officePhoto from '../assets/images/office/2026-10-25.jpg';

// Every weather photo, grouped per season and sky; columns are the dayparts. Sample temperatures only.
const temps: Record<string, number> = { lente: 14, zomer: 22, herfst: 12, winter: 3, sneeuw: -1, vorst: -4, onweer: 21 };
const weatherPanels = Object.entries(Object.groupBy(allScenes(), (s) => (['sneeuw', 'vorst', 'onweer'].includes(s.sky) ? 'vast seizoen' : s.season))).map(
  ([title, scenes]) => ({ title, rows: Object.values(Object.groupBy(scenes!, (s) => s.sky)).map((r) => r!.map((s) => ({ ...s, temperature: `${temps[s.sky] ?? temps[s.season]} °` }))) }),
);
// Christmas countdown: stage 0 → 12 (one step every two days in December), day and night.
const christmasStates = [
  { days: 61, stage: 0, note: 'voor december' },
  { days: 12, stage: 6, note: 'halverwege' },
  { days: 1, stage: 12, note: 'kerstavond' },
  { days: 0, stage: 12, note: 'kerst' },
];
---

<BaseLayout title="Widgets — Flits" noindex>
  <main class="wg">
    <header>
      <p class="wg-eyebrow">Flits design system</p>
      <Heading as="h1" size="116">Widgets</Heading>
      <Text size="l" tone="secondary">Alle widgets en hun varianten. Live widgets bovenaan, vaste states eronder.</Text>
    </header>

    <!-- Widgetplekken -->
    <section class="wg-block">
      <div class="wg-head">
        <Heading size="36">Widgetplekken</Heading>
        <code>src/data/widgets.ts · zonder vaste keuze kiest een plek per bezoek een willekeurige widget uit zijn pool</code>
      </div>
      <div class="wg-panel" data-theme="light">
        <table class="wg-table">
          <thead><tr><th>Plek</th><th>Formaat</th><th>Waar</th><th>Pool</th><th>Vast per pagina</th></tr></thead>
          <tbody>
            {slots.map((s) => (
              <tr>
                <td><code>{s.id}</code></td>
                <td>{s.size}</td>
                <td>{s.where}</td>
                <td>{pools[s.size].join(', ') || '—'}</td>
                <td>{Object.entries(fixed).filter(([, f]) => f[s.id]).map(([page, f]) => `${page}: ${f[s.id]}`).join(' · ') || '—'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- Live -->
    <section class="wg-block">
      <div class="wg-head">
        <Heading size="36">Live</Heading>
        <code>zoals op de site: echt weer, echte tijd, echte aftelling</code>
      </div>
      <div class="wg-panel wg-row" data-theme="light">
        <WeatherWidget />
        <ClockWidget />
        <ClockWidget layout="wide" />
        <MapWidget />
        <SpotifyWidget />
        <PageSpeedWidget />
        <ReviewsWidget />
        <OfficeWidget />
        <StoriesWidget />
        <ChristmasWidget />
      </div>
    </section>

    <!-- PageSpeed -->
    <section class="wg-block">
      <div class="wg-head">
        <Heading size="36">PageSpeedWidget</Heading>
        <code>echte PSI-score van SITE_URL (build + /api/pagespeed, 24 u gecachet) · result? pint een stand</code>
      </div>
      <div class="wg-panel wg-row" data-theme="light">
        <PageSpeedWidget result={{ mobile: 98, desktop: 100, measuredAt: '2026-10-25T12:00:00Z', stale: false }} />
        <PageSpeedWidget result={{ mobile: 72, desktop: 91, measuredAt: '2026-10-25T12:00:00Z', stale: false }} />
        <PageSpeedWidget result={{ mobile: 41, desktop: 63, measuredAt: '2026-10-25T12:00:00Z', stale: false }} />
        <PageSpeedWidget result={{ mobile: null, desktop: null, measuredAt: '2026-10-25T12:00:00Z', stale: true }} />
      </div>
    </section>

    <!-- Kijk binnen -->
    <section class="wg-block">
      <div class="wg-head">
        <Heading size="36">OfficeWidget</Heading>
        <code>nieuwste foto uit src/content/office-photos.json · "vers" alleen op de dag zelf · today? pint de datum</code>
      </div>
      <div class="wg-panel wg-row" data-theme="light">
        <OfficeWidget today="2026-10-25" />
        <OfficeWidget today="2026-10-28" />
        <OfficeWidget today="2026-11-20" />
      </div>
    </section>

    <!-- Bericht van de studio -->
    <section class="wg-block">
      <div class="wg-head">
        <Heading size="36">StudioPostWidget</Heading>
        <code>src/content/studio-posts.json (nu nog leeg → widget uit elke pool) · voorbeeld hieronder via posts=</code>
      </div>
      <div class="wg-panel wg-row" data-theme="light">
        <StudioPostWidget posts={[
          { author: 'jordi', date: new Date('2026-10-25'), text: 'Voorbeeld: herfst bij ons kantoor. De koffie staat klaar, loop gerust binnen.', image: officePhoto },
          { author: 'joery', date: new Date('2026-10-20'), text: 'Voorbeeld: vandaag een draaidag in Emmen, morgen alles monteren.' },
        ]} />
      </div>
    </section>

    <!-- Kerst -->
    <section class="wg-block">
      <div class="wg-head">
        <Heading size="36">Kerst</Heading>
        <code>SpotifyWidget · ChristmasWidget days? stage? (0–12) dark? — foto's: assets/images/widgets/christmas/dag-NN|nacht-NN.jpg, ontbrekende vallen terug</code>
      </div>
      <div class="wg-panel" data-theme="light">
        <span class="wg-tag">brede plek contact-wide · 4 december (kerst in seizoen) · 30 november (plek valt weg)</span>
        <div class="wg-row">
          <WidgetSlot id="contact-wide" size="wide" fallback="christmas" today="2026-12-04" />
          <WidgetSlot id="contact-wide" size="wide" fallback="christmas" today="2026-11-30" />
          <span class="wg-tag">← niets</span>
        </div>
      </div>
      {[false, true].map((dark) => (
        <div class="wg-panel" data-theme="light">
          <span class="wg-tag">{dark ? 'nacht' : 'dag'}</span>
          <div class="wg-row">
            {christmasStates.map((s) => <ChristmasWidget days={s.days} stage={s.stage} dark={dark} />)}
          </div>
        </div>
      ))}
    </section>

    <!-- WeatherWidget -->
    <section class="wg-block">
      <div class="wg-head">
        <Heading size="36">WeatherWidget</Heading>
        <code>live via Open-Meteo · scene? pint één foto (seizoen-dagdeel-weer) zonder live weer · 92 foto's</code>
      </div>
      {weatherPanels.map((panel) => (
        <div class="wg-panel" data-theme="light">
          <span class="wg-tag">{panel.title} · ochtend · middag · avond · nacht</span>
          {panel.rows.map((row) => (
            <div class="wg-row">
              {row.map((s) => <WeatherWidget scene={s.key} condition={s.label} temperature={s.temperature} date={s.sky} />)}
            </div>
          ))}
        </div>
      ))}
    </section>
  </main>
</BaseLayout>

<style>
  .wg {
    width: min(100% - 2 * var(--space-48), var(--container-max));
    margin-inline: auto;
    padding-block: var(--space-96);
    display: grid;
    gap: var(--space-96);
  }
  .wg-eyebrow {
    font: var(--text-body-s);
    background: var(--color-brand-500);
    color: var(--color-dark-900);
    display: inline-block;
    padding: var(--space-4) var(--space-8);
    margin-bottom: var(--space-16);
  }
  code {
    font: var(--text-caption);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    color: var(--color-text-muted);
  }
  .wg-block {
    display: grid;
    gap: var(--space-16);
  }
  .wg-head {
    display: grid;
    gap: var(--space-8);
    margin-bottom: var(--space-8);
  }
  .wg-panel {
    padding: var(--space-32);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    display: grid;
    gap: var(--space-16);
    align-content: start;
  }
  .wg-tag {
    font: var(--text-caption);
    color: var(--color-text-muted);
    text-transform: uppercase;
  }
  .wg-table {
    width: 100%;
    border-collapse: collapse;
    font: var(--text-body-s);
    text-align: left;
  }
  .wg-table th,
  .wg-table td {
    padding: var(--space-8) var(--space-12);
    border-bottom: 1px solid var(--color-border);
    vertical-align: top;
  }
  .wg-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-16);
  }
</style>
