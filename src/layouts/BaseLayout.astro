---
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/themes.css';
import '../styles/base.css';
import '../styles/motion.css';

interface Props {
  title: string;
  description?: string;
  theme?: 'light' | 'surface' | 'dark';
  noindex?: boolean;
  /** Absolute or root-relative URL of a share image (Open Graph), e.g. a case hero. */
  image?: string;
}

const { title, description, theme = 'light', noindex = false, image } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Without a page image, links shared on WhatsApp still show the Flits logo
const ogImage = new URL(image ?? '/og-default.jpg', Astro.site);
// The nav intro plays on the home page only: on other landing pages the menu is there at once
const landing = Astro.url.pathname === '/';
import CursorMarquee from '../components/molecules/CursorMarquee.astro';
import ProgressiveBlur from '../components/atoms/ProgressiveBlur.astro';
import GridOverlay from '../components/atoms/GridOverlay.astro';
import ContactModal from '../components/sections/ContactModal.astro';
---

<!doctype html>
<html lang="nl" data-landing={landing ? '' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#140218" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="nl_NL" />
    <meta property="og:site_name" content="Flits" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preload" href="/fonts/pp-right-grotesk-wide-black.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/gt-standard-l-semibold.woff2" as="font" type="font/woff2" crossorigin />
    <!-- Page width without the scrollbar for the column tokens (100vw counts the scrollbar on Windows) -->
    <script is:inline>
      new ResizeObserver(() =>
        document.documentElement.style.setProperty('--page-width', document.documentElement.clientWidth + 'px'),
      ).observe(document.documentElement);
    </script>
  </head>
  <body data-theme={theme}>
    <slot />
    <CursorMarquee />
    <ProgressiveBlur />
    {import.meta.env.DEV && <GridOverlay />}
    <ContactModal />
    <script>
      import '../scripts/app';
    </script>
  </body>
</html>
